# EOL fixado em LF (SAC-107, rodada r9 do radar E3): num checkout Windows com
# core.autocrlf=true os .sh chegariam com CRLF e o bash dos hooks quebraria.
# Lista decidida pela medição do repo (git ls-files --eol, 2026-10-11): só
# extensões que vivem no repo. *.csv fica FORA de propósito: 13 CSVs de
# provenance-triage já vivem com CRLF no índice e não podem mudar de bytes.

# Executáveis (shell, hooks sem extensão, interpretados)
*.sh        text eol=lf
*.awk       text eol=lf
*.py        text eol=lf
*.js        text eol=lf
*.mjs       text eol=lf
*.ts        text eol=lf
.githooks/* text eol=lf

# Dados e especificação lidos pelos scripts
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.jsonl     text eol=lf
*.tsv       text eol=lf
*.tpl       text eol=lf
*.md        text eol=lf

# Estratégia de merge preservada (append-only)
.claude/session-lifecycle.jsonl text eol=lf merge=union

# Bancada: famílias novas acrescentadas lado a lado por PRs paralelos (SAC-146). NÃO é union — o
# union juntaria também duas edições da mesma linha. O driver só resolve conflito de base vazia entre
# blocos inteiros de família; o resto fica conflito. Sem o driver na config, vale o merge de texto.
.claude/validation/lint-selftest.sh merge=onion-selftest-families

# Binários: nunca normalizar
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# O VENDOR DO CONTRATO KG-SSOT viaja BYTE A BYTE (2026-10-17, subida para kg-ssot-v4.8.0): o
# kg_vendor.py check confere o sha256 de cada arquivo contra o carimbo da tag, e a 4.8.0 traz
# fixtures de conformidade do perfil JSON com CRLF DE PROPÓSITO (whitespace da RFC 8259). O
# `*.json text eol=lf` acima as normalizava no índice, e um checkout novo (o CI) via 2 arquivos
# "editados": medido exportando o índice e rodando o check (rc=1). `-text` vem DEPOIS para vencer.
vendor/kg-ssot/** -text
