# Histórico do Claude Code
.history/

# Worklogs de sessão (.claude/sessions/) — versionamento é ESCOLHA CONSCIENTE por projeto.
# Default do Onion: gitignore (estado individual/efêmero). Para tratar worklogs como
# artefato durável de time/auditoria, comente a linha abaixo (ou faça un-ignore de archived/).
# Política: docs/knowledge-base/frameworks/gitflow-patterns.md §Contrato de Sessão → Versionamento de sessões.
.claude/sessions/

# Stamp de versão de repo ADOTADO — o repo-fonte (este) não carrega stamp committado
# (architecture.md §6.1: identidade lida ao vivo via onion-version.sh). Backstop p/ o caso
# de /meta:adopt apontar para este próprio repo, ou cópia acidental do stamp.
.claude/.onion-version

# Arquivos temporários
*.tmp
*.temp
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Arquivos de ambiente (caso existam)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache e builds temporários
.cache/
dist/
build/
node_modules/

# Arquivos do sistema
*.swp
*.swo
*~
.vscode/
.idea/
.tmp/
# Claude Code local overrides (não versionar)
.claude/settings.local.json
# Registro MCP do projeto-alvo (cópia de .mcp.json.example; pode conter config específica)
.mcp.json

# Python bytecode (MCP servers em ops/) — nunca versionar
__pycache__/
*.pyc

# Fixture TRANSITÓRIA da bancada (run_marketplace_bundle_selftests): nasce e morre em
# .claude/utils/marketplace/verticals/ porque o caso testa que o LINT, que varre esse dir, acusa
# manifesto sem plugin. Enquanto ela existe, um `git add -A` concorrente a staja e o lint passa a
# ver manifesto órfão → REGRA 19 HARD. Aconteceu 3× em 2026-09-05. Ignorar é a cura barata; mover a
# fixture exigiria redesenhar o caso (ele PRECISA do dir vivo).
.claude/**/__*__.*
plugins/__*__/

# Scratchpad da SESSÃO — parking-lot de nota e material baixado para leitura (PDFs de fonte primária,
# rascunho de script). É transitório por definição: o que vale vira nó no grafo, caso de bancada ou
# documento. Em 2026-09-13 um run de pesquisa baixou 748 KB de PDF de terceiro aqui.
.claude/scratchpad/
