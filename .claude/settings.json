{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git branch)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(ls .claude/*)",
      "Bash(wc -l *)",
      "Bash(find .claude *)",
      "Read",
      "Grep",
      "Glob"
    ],
    "deny": [
      "Bash(git push* --force)",
      "Bash(git push* --force *)",
      "Bash(git push* -f*)",
      "Bash(git push* -uf*)",
      "Bash(git push* -vf*)",
      "Bash(git push* -qf*)",
      "Bash(git -* push --force)",
      "Bash(git -* push --force *)",
      "Bash(git -* push * --force)",
      "Bash(git -* push * --force *)",
      "Bash(git -* push -f*)",
      "Bash(git -* push * -f*)",
      "Bash(git -* push -uf*)",
      "Bash(git -* push -vf*)",
      "Bash(git -* push -qf*)",
      "Bash(git push* --mirror*)",
      "Bash(git -* push --mirror*)",
      "Bash(git -* push * --mirror*)",
      "Bash(git filter-branch*)",
      "Bash(git filter-repo*)",
      "Bash(git -* filter-branch*)",
      "Bash(git -* filter-repo*)",
      "Bash(git clean* -x*)",
      "Bash(git clean* -fx*)",
      "Bash(git clean* -fdx*)",
      "Bash(git clean* -dfx*)",
      "Bash(git clean* -dx*)",
      "Bash(git clean* -X*)",
      "Bash(git clean* -fX*)",
      "Bash(git clean* -fdX*)",
      "Bash(git clean* -dfX*)",
      "Bash(git clean* -dX*)",
      "Bash(git clean* -ffx*)",
      "Bash(git clean* -ffdx*)",
      "Bash(git clean* -ffX*)",
      "Bash(git clean* -ffdX*)",
      "Bash(git -* clean -x*)",
      "Bash(git -* clean -fx*)",
      "Bash(git -* clean -fdx*)",
      "Bash(git -* clean -dfx*)",
      "Bash(git -* clean -dx*)",
      "Bash(git -* clean -X*)",
      "Bash(git -* clean -fX*)",
      "Bash(git -* clean -fdX*)",
      "Bash(git -* clean -dfX*)",
      "Bash(git -* clean -dX*)",
      "Bash(git -* clean -ffx*)",
      "Bash(git -* clean -ffdx*)",
      "Bash(git -* clean -ffX*)",
      "Bash(git -* clean -ffdX*)",
      "Bash(git -* clean * -x*)",
      "Bash(git -* clean * -X*)",
      "Bash(rm -*r* /)",
      "Bash(rm -*r* / *)",
      "Bash(rm -*r* ~)",
      "Bash(rm -*r* ~/)",
      "Bash(rm -*r* $HOME)",
      "Bash(rm -*r* .git)",
      "Bash(rm -*r* .git/)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete *)",
      "Bash(gh repo edit*--visibility*)",
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.prod)",
      "Read(//**/.env.production)",
      "Read(//**/.env.staging)",
      "Read(//**/.env.development)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.netrc)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.claude/.credentials.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/task-manager-provider-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Detectando Task Manager provider (Onion)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worklog-capture-session.sh\"",
            "timeout": 5,
            "statusMessage": "Capturando session_id no worklog (Onion)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/co-evolution-inbox-check.sh\"",
            "timeout": 5,
            "statusMessage": "Checando inbox de co-evolução (Onion)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-plugin-write-scan.sh\"",
            "timeout": 5,
            "statusMessage": "Varrendo plugin em .claude/skills (Onion)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-beacon-hook.sh\" up",
            "timeout": 5,
            "statusMessage": "Acendendo farol de sessão (Onion)"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/validation/memory-write-scan-check.sh\" --session",
            "timeout": 5,
            "statusMessage": "Varrendo a memória por envelope de canal (Onion)"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-beacon-hook.sh\" refresh",
            "timeout": 5,
            "statusMessage": "Refrescando farol de sessão (Onion)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/aside-router-hook.sh\"",
            "timeout": 5,
            "statusMessage": "Roteando aparte do maestro (Onion)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/background-task-probe.sh\"",
            "timeout": 5,
            "statusMessage": "Medindo tarefas de fundo (Onion)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-version-drift.sh\"",
            "timeout": 5,
            "statusMessage": "Conferindo versão do processo vs disco (Onion)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-currency-check.sh\"",
            "timeout": 15,
            "statusMessage": "Conferindo se a base está nas versões atuais (Onion)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-degraded-notice.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/house-code-gloss.sh\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-beacon-hook.sh\" down",
            "timeout": 5,
            "statusMessage": "Apagando farol de sessão (Onion)"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/worklog-precompact-breadcrumb.sh\"",
            "timeout": 5,
            "statusMessage": "Breadcrumb de compaction no worklog (Onion)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/bash-empty-result-guard.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-env-guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-protect-main.sh\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-merge-gate.sh\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-moat-gate.sh\"",
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-direct-provider-api.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-plugin-write-guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/kg-read-leg.sh\""
          }
        ]
      },
      {
        "matcher": "SendMessage|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/house-code-gloss.sh\" tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-memory-write-guard.sh\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pretooluse-adopter-guard.sh\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/premodelswitch-guard.sh\"",
            "timeout": 5,
            "onFailure": "block",
            "statusMessage": "Guarda de modelo da sessão (Onion): veta downgrade fora do lineup"
          }
        ]
      }
    ],
    "PostModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/premodelswitch-guard.sh\"",
            "timeout": 5,
            "statusMessage": "Registrando troca de modelo (Onion)"
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/instructions-loaded-log.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/rule-title-in-prose.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/house-code-gloss.sh\" stop",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "fallbackModel": [
    "claude-opus-5-5",
    "claude-opus-5",
    "claude-sonnet-5-5"
  ],
  "attribution": {
    "commit": "Orquestrado com 🧅 Onion Evolve",
    "pr": "Orquestrado com 🧅 Onion Evolve"
  }
}
