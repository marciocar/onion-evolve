#!/usr/bin/env python3
"""Linha da statusLine: quantas sessões trabalham e quantas esperam você.

Lê `claude agents --json`, a interface suportada do Claude Code (sem mod). Guarda a leitura por TTL segundos,
para várias sessões não dispararem um processo de ~150 MB a cada atualização (medido 2026-11-21: 0,5 s e
156 MB por chamada). Falhou a leitura: mostra a última com a idade, ou declara a lacuna. NUNCA inventa zero:
"0 trabalhando" só sai de uma leitura real que veio vazia.

Portável (insumo da curadoria, costurado no core em 2026-11-21):
- o binário `claude` vem SÓ do PATH (`shutil.which`); fora do PATH a atualização falha e cai no cache ou na
  lacuna declarada, nunca num caminho chutado de home;
- o cache mora em XDG_RUNTIME_DIR (ou no tmp do SO), nunca em $HOME;
- sai SEMPRE rc 0: statusLine que sai != 0 some da barra, então todo caminho (sem leitura, cache velho, erro)
  imprime uma linha e retorna 0. A lacuna é texto visível, não silêncio.

O fim da linha aponta o agent view nativo («← claude agents»): a statusLine é texto, sem clique; quem lista por
estado e pula para a sessão é o `claude agents` (ou a seta para a esquerda no prompt vazio).
Ligar: .claude/utils/statusline/README.md. Bancada: lint-selftest.sh (run_sessions_statusline_selftests).
"""
import hashlib
import json
import os
import shutil
import stat
import subprocess
import sys
import tempfile
import time

try:
    import fcntl  # trava entre sessões; sem ela (SO sem fcntl) a linha segue, só sem a trava
except ImportError:  # pragma: no cover
    fcntl = None

TTL = 25
STALE = 90
HINT = " · ← claude agents"
KNOWN_STATUS = ("busy", "waiting", "idle")  # medido em `claude agents --json` (CC 2.1.330, 2026-11-21)
KNOWN_STATE = ("blocked", "done")
# A pasta leva o uid (e a conta, quando CLAUDE_CONFIG_DIR a separa): sem XDG_RUNTIME_DIR ela cai no tmp do SO, que é de
# todos, e um nome fixo deixaria outro usuário plantá-la antes (revisão isolada de 2026-11-21, achado 1).
_ACCOUNT = os.environ.get("CLAUDE_CONFIG_DIR") or ""
_SUFFIX = str(os.getuid()) + ("-" + hashlib.sha256(_ACCOUNT.encode()).hexdigest()[:8] if _ACCOUNT else "")
CACHE_DIR = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir(), "onion-sessions-line-" + _SUFFIX)
CACHE = os.path.join(CACHE_DIR, "agents.json")
LOCK = os.path.join(CACHE_DIR, "lock")


def say(text):
    print(text + HINT)


def safe_dir():
    """A pasta do cache é diretório de verdade (não symlink), deste usuário e só dele (0700). Senão, nada se lê nem escreve."""
    st = os.lstat(CACHE_DIR)
    return stat.S_ISDIR(st.st_mode) and st.st_uid == os.getuid() and stat.S_IMODE(st.st_mode) & 0o077 == 0


def clean(value):
    """Nome de sessão é dado de outra sessão: tira caractere de controle (escape de terminal) e corta em 24."""
    return "".join(ch for ch in str(value or "?") if ch.isprintable())[:24] or "?"


def age():
    try:
        return time.time() - os.path.getmtime(CACHE)
    except OSError:
        return None


def refresh():
    """Atualiza o cache. Quem não pega a trava serve o que já existe, sem esperar.

    `claude` vem só do PATH. Fora do PATH: FileNotFoundError sobe e o chamador cai no cache ou na lacuna.
    """
    # O_NOFOLLOW e sem truncar: a trava nunca segue symlink nem zera arquivo de ninguém
    with os.fdopen(os.open(LOCK, os.O_CREAT | os.O_WRONLY | os.O_NOFOLLOW, 0o600), "w") as lock:
        if fcntl is not None:
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return
        claude = shutil.which("claude")
        if not claude:
            raise FileNotFoundError("claude não está no PATH")
        out = subprocess.run([claude, "agents", "--json"], capture_output=True, text=True, timeout=5, check=True).stdout
        if not isinstance(json.loads(out), list):
            raise ValueError("claude agents --json não devolveu uma lista")
        fd, tmp = tempfile.mkstemp(dir=CACHE_DIR)
        with os.fdopen(fd, "w") as f:
            f.write(out)
        os.replace(tmp, CACHE)


def main():
    os.makedirs(CACHE_DIR, mode=0o700, exist_ok=True)
    if not safe_dir():
        say("sessões: cache inseguro, não li")  # lacuna declarada: pasta de outro dono, aberta ou symlink
        return
    current = age()
    if current is None or current < 0 or current > TTL:  # mtime no futuro (relógio que voltou) também relê
        try:
            refresh()
        except (OSError, ValueError, subprocess.SubprocessError):
            pass  # cai no cache ou na lacuna; nunca propaga rc != 0 para a barra
    current = age()
    if current is None:
        say("sessões: não li o estado")  # lacuna declarada: nenhuma leitura ainda
        return
    try:
        with open(CACHE) as f:
            data = json.load(f)
        if not isinstance(data, list):
            raise ValueError("cache não é lista")
    except (OSError, ValueError):
        say("sessões: leitura ilegível")  # lacuna declarada: cache corrompido
        return
    rows = [x for x in data if isinstance(x, dict)]
    wait = [x for x in rows if x.get("state") == "blocked" or x.get("status") == "waiting"]
    work = [x for x in rows if x.get("status") == "busy" and x not in wait]
    # estado que esta linha não conhece (o esquema mudou) aparece contado, nunca some num zero
    other = [x for x in rows if x not in wait and x not in work
             and x.get("status") not in KNOWN_STATUS and x.get("state") not in KNOWN_STATE]
    line = f"sessões: {len(work)} trabalhando · {len(wait)} esperam você"
    if wait:
        line += ": " + ", ".join(clean(x.get("name")) for x in wait)
    if other:
        line += f" · {len(other)} em estado desconhecido"
    if current > STALE:
        line += f" (leitura de {int(current)} s atrás)"
    say(line)


if __name__ == "__main__":
    try:
        sys.stdout.reconfigure(errors="replace")  # locale sem UTF-8 não vira exceção no print
    except (AttributeError, ValueError):
        pass
    try:
        main()
    except Exception as exc:  # a barra nunca deve quebrar por causa da linha
        try:
            print(f"sessões: indisponível ({type(exc).__name__}){HINT}")
        except Exception:
            pass
    sys.exit(0)  # rc 0 SEMPRE: statusLine que sai != 0 some da barra
