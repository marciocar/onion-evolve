// /en/doutrinas/ — the English mirror of the public doctrines page (F4, reform 2026-08).
//
// Same editorial contract as the pt-BR page, and it does not change: one-line thesis →
// THE SCAR (the real, dated mistake that produced it) → the mechanism that enforces it.
// A doctrine without a scar is a slogan; a scar without a mechanism is a complaint.
// Where there is no mechanism, this page says so.
//
// FOLLOW-UP (known, accepted for now): Base.astro hardcodes lang="pt-BR", so this page
// ships with the wrong html lang attribute. The layout needs a `lang` prop before /en/
// grows past the two key pages.
import Base from '../../../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import '../../../styles/doutrinas.css';

// The named-inventions table is a TRANSCRIPTION of the internal knowledge base §1.5,
// derived on 2026-08-25 — frozen-in-time class. Parsing the cells was deliberately
// refused: they carry internal paths and adopter names that must not leave the repo.
// Only the ROW COUNT is read from the file, so this page can flag its own drift instead
// of ageing in silence (source ≠ derivation applied to itself).
let kbCount: number | null = null;
try {
  const kb = readFileSync(
    fileURLToPath(new URL('../../../../../docs/knowledge-base/meta/onion-framework-identity.md', import.meta.url)),
    'utf8',
  );
  const bloco = kb.split('## 1.5')[1]?.split('\n## ')[0] ?? '';
  kbCount = bloco.split('\n').filter((l) => /^\|\s*\*\*/.test(l)).length;
} catch {
  kbCount = null; // built outside the core repo: no check, and no broken build
}

const inventions = [
  { name: 'Dogfood Doctrine', what: 'every core change is validated by running the real artifact; the fix is a new dogfood input, not the end of one.', home: 'internal knowledge base', status: 'active' },
  { name: 'Modernization Doctrine', what: 'which refactoring pattern to apply without breaking the framework’s invariants.', home: 'internal knowledge base', status: 'active' },
  { name: 'Abstraction Doctrine', what: 'when something deserves to become an abstraction — the Axis Test and the Trigger Test, both of which can fail a proposal.', home: 'internal knowledge base', status: 'active since 2026-07-17' },
  { name: 'Economy of Motors', what: 'three engines are available (the large model, the small model as a tool, the deterministic shell); use the cheapest one that can do the job.', home: 'internal knowledge base', status: 'active' },
  { name: 'SDAAL', what: 'one interface, N providers: the specification is the artifact and the model is the runtime that executes it.', home: 'internal knowledge base + whitepaper', status: 'active' },
  { name: 'KG SDAAL', what: 'investigations and domains modelled as a typed graph, with truths reconciled through refutation and supersession edges.', home: 'internal knowledge base', status: 'active — now infrastructure (radar, console, commands, lint guards)' },
  { name: 'SSOT-as-runtime', what: 'the source of truth is a program that runs: read the graph, verify against the living artifact, act, write back.', home: 'internal knowledge base', status: 'active — mechanism on the write leg; the read leg is declared as advice' },
  { name: 'gated-until-trigger', what: 'an artifact is born from the use that proves it, never from symmetry or from a plan.', home: 'internal knowledge base', status: 'active' },
  { name: 'declared ≠ verified', what: 'a stamp, a document or a branch is a hypothesis; only the living artifact is proof.', home: 'internal knowledge base', status: 'active' },
  { name: 'source ≠ derivation', what: 'the source and our reading of it live in physically separate artifacts; the derivation cites, it never rewrites.', home: 'internal knowledge base', status: 'active' },
  { name: 'Phased Resumable Pattern', what: 'a durable session with state on disk and cold resumption; phases are never merged.', home: 'internal architecture decision', status: 'provisional — yet to be written into the constitution' },
  { name: 'Capability Contract', what: 'what an adopting repository can expect from the framework, in machine-verifiable tiers.', home: 'internal architecture decision', status: 'active — decision plus mechanism (blocking lint guard)' },
  { name: 'Co-Evolution Protocol', what: 'a bidirectional signal between the core and its adopters, carried by versioned files — no coupled runtime between repositories.', home: 'internal protocol + commands', status: 'active' },
  { name: 'Breadcrumbs', what: 'an explicit signal left inside the artifact that forces absorption instead of accommodation — with a re-test deadline.', home: 'internal knowledge base + diary command', status: 'active' },
  { name: 'Object-led discovery', what: 'the thing that knows about the object is the object itself: the maestro steers with it, the model executes with the right parts.', home: 'internal knowledge base + architecture decision', status: 'active' },
  { name: 'Autobiographical Marketing', what: 'the framework tells its own story; the commits are the autobiography.', home: 'internal manual', status: 'manual prose only — still no mechanism' },
  { name: "Maestro's Aside", what: 'a typed side channel: a marker at the start of a message injects the canonical route — recall, not a block.', home: 'internal knowledge base + runtime hook', status: 'active since 2026-08-04' },
];
