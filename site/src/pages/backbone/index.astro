---
// /backbone/ — o backbone de comunicação e a tabela de critérios e valores (2026-11-12).
//
// PROVENIÊNCIA (fonte≠derivação): os selos D_COMMS_BACKBONE_COMPOSED_1112 e
// D_COMMS_BACKBONE_VALUE_TABLE_1112 do grafo do estudo company-brain-non-devs-2026-11, e a
// tabela comms-backbone-value-table.md do mesmo estudo (PRs #1627 e #1632). Esta página é
// projeção à mão, datada: se a tabela mudar no estudo, esta página fica atrás até ser
// recurada (selo "congelado no tempo" no rodapé de cada seção).
//
// FRONTEIRA EDITORIAL: publica-se a decisão, os critérios e o estado declarado. Nenhum nome
// de adotante, de cliente ou de pessoa; o comparável direto não é nomeado, porque o veredito
// da curadoria sobre ele ainda não está selado no grafo do core.
import Base from '../../layouts/Base.astro';
import '../../styles/estado.css';

type Linha = { valor: string; recebe: string; medida: string; superacao: string; hoje: string; nivel: 'parcial' | 'falta' | 'medir' };

const tabela: Linha[] = [
  { valor: 'Segurança', recebe: 'só agente autorizado fala e age', medida: '100% das mensagens com identidade verificada; nenhuma credencial fora do conector; teste de intrusão', superacao: 'identidade assinada por agente e veto determinístico por tipo de ação, além da aprovação humana genérica', hoje: 'parcial: assinatura no canal entre agentes; veto por tipo na rota de envio, em revisão', nivel: 'parcial' },
  { valor: 'Criptografia', recebe: 'conteúdo protegido em trânsito e em repouso', medida: 'TLS em todo salto; assinatura em 100%; cifra do corpo onde for pedida', superacao: 'chaves e assinaturas sob controle do cliente, em self-host (na infraestrutura do próprio cliente)', hoje: 'parcial: assinatura existe; TLS por salto e cifra do corpo a medir', nivel: 'parcial' },
  { valor: 'Rastreabilidade', recebe: 'quem pediu, quem agiu e o que saiu', medida: '% de mensagens com quem pediu e quem agiu recuperáveis', superacao: 'quem pediu e quem agiu aparece no próprio post e fica no registro, ligado ao grafo', hoje: 'parcial: linha de base de 12/11 com quem pediu em 20 de 20 e quem agiu em 1 de 20', nivel: 'parcial' },
  { valor: 'Observabilidade', recebe: 'ver o fluxo de ponta a ponta', medida: 'p95 e p99 de latência por salto (o tempo dentro do qual chegam 95% e 99% das mensagens); traço por mensagem pelo id do evento', superacao: 'cada evento rastreável até a decisão que gerou no grafo', hoje: 'falta', nivel: 'falta' },
  { valor: 'Monitoramento', recebe: 'saber na hora quando algo para', medida: 'tempo para detectar agente ou conector parado; alertas falsos por semana', superacao: 'detecta agente parado ou calado pelo sintoma, qualquer que seja a causa', hoje: 'parcial: o pulso da batuta acusa agente parado ou calado (PRs #1617 e #1622)', nivel: 'parcial' },
  { valor: 'Eventos', recebe: 'reagir ao fato, não varrer', medida: '% de entrada por evento contra busca periódica; vigias por varredura eliminadas', superacao: 'cada mensagem atendida uma vez só, com zero resposta em dobro medida', hoje: 'falta: o Slack ainda é lido por busca', nivel: 'falta' },
  { valor: 'Agendamento', recebe: 'mensagem e tarefa na hora marcada, com garantia', medida: '% entregue dentro da janela; atraso médio', superacao: 'toda rotina tem dono visível no post', hoje: 'a medir', nivel: 'medir' },
  { valor: 'Gestão de falhas', recebe: 'nada se perde, nada se duplica', medida: 'zero perda e zero dobro numa semana; entrega uma vez sob queda; tempo de recuperação', superacao: 'entrega uma vez sob queda, a provar, com critério registrado antes do teste (PR #1624)', hoje: 'parcial: fila durável existe; o teste de queda ainda não tem resultado', nivel: 'parcial' },
  { valor: 'Auditoria', recebe: 'prova para TI, jurídico e regulador', medida: 'trilha assinada e imutável; pacote de evidência gerado; tempo para responder a um pedido de auditoria', superacao: 'decisões seladas com testemunho e revisão adversarial, com pacote de evidência gerado do grafo', hoje: 'parcial: selos e grafo existem; falta o pacote do tráfego', nivel: 'parcial' },
  { valor: 'Soberania', recebe: 'dado e operação sob controle do cliente', medida: 'roda 100% em self-host; nenhum serviço de terceiro no caminho do núcleo', superacao: 'agente-neutro e self-host, sem serviço de terceiro no caminho do núcleo', hoje: 'parcial: por desenho; a prova vem no empacotamento', nivel: 'parcial' },
];

const ordem = [
  ['1', 'Slack por evento', 'Cada mensagem entra uma vez e é atendida por um único agente, nunca por dois; a resposta sai pelo bot, com a linha de quem pediu.', 'em curso'],
  ['2', 'Descoberta de sessões', 'As sessões passam a se enxergar sem depender da configuração de cada uma.', 'a fazer'],
  ['3', 'Conformidade A2A 1.0', 'O cartão de identidade do agente, assinado, para o que cruza máquina ou dono.', 'a fazer'],
  ['4', 'E-mail', 'O e-mail entra no mesmo fluxo de eventos.', 'a fazer'],
  ['5', 'Barramento pesado, só quando medido', 'Mais de uma máquina, volume ou replay. Entra atrás da mesma interface, sem mudar o contrato.', 'condicional'],
];
---

<Base
  title="Backbone de comunicação — Onion Evolve"
  description="A espinha de comunicação do Onion entre agentes, sessões, Slack e e-mail: composição sobre padrões abertos, a ordem de construção pela dor medida e a tabela de critérios e valores, com a coluna Superação."
  path="/backbone/"
>

<section class="est-hero">
  <div class="wrap">
    <span class="est-kick">Decisão do maestro · 12 de novembro de 2026 · Delphi unânime</span>
    <h1>O encanamento não se vende. <em>As qualidades dele, medidas, sim.</em></h1>
    <p class="est-lead">Esta é a espinha de comunicação que o Onion vai construir entre agentes, sessões,
    Slack e e-mail. Ela é composta de padrões abertos (A2A 1.0, CloudEvents, MCP), tem núcleo estreito e
    conectores na periferia, e deixa o grafo de conhecimento <b>fora</b> do caminho de entrega. Quatro
    sessões chegaram a ela por unanimidade num Delphi, e o maestro a selou corrigindo a síntese.</p>
  </div>
</section>

<section class="est-sec est-sec-alt" id="ordem">
  <div class="wrap">
    <span class="est-kick">1 · O que se constrói</span>
    <h2>A ordem segue <em>a dor medida</em>.</h2>
    <ol class="bb-ordem">
      {ordem.map(([n, t, d, e]) => (
        <li><span class="bb-n">{n}</span><div><h3>{t} <span class={`bb-tag ${e === 'em curso' ? 'curso' : ''}`}>{e}</span></h3><p>{d}</p></div></li>
      ))}
    </ol>
    <div class="est-nota">
      <h3>O aceite da fundação</h3>
      <p>Uma semana de tráfego real com zero mensagem perdida (conferida contra o histórico do canal),
      zero resposta em dobro, todo envio pelo bot, sem credencial fora do conector, e 95% das menções
      atendidas em menos de 60 segundos. O empacotamento, em open-core (a base aberta e a governança paga), só começa depois que isso passar
      no uso real.</p>
    </div>
    <p class="est-selo congelado">classe <b>congelado no tempo</b> · selo D_COMMS_BACKBONE_COMPOSED_1112, PR #1627, 2026-11-12</p>
  </div>
</section>

<section class="est-sec" id="valores">
  <div class="wrap">
    <span class="est-kick">2 · O que se vende</span>
    <h2>A tabela de <em>critérios e valores</em>.</h2>
    <p class="est-lead">A síntese do Delphi dizia que o transporte é fundação e não se vende. O maestro
    corrigiu ao selar: o que não se vende sozinho é mover bytes de A para B. As qualidades do transporte
    se vendem, se cada uma tiver critério e medida. A coluna <b>Superação</b> diz onde pretendemos ir além
    do mercado, e é <b>hipótese</b> até o veredito sobre o comparável direto ser selado. A coluna
    <b>Hoje</b> é a leitura do core em 12/11, a medir peça por peça. Nada aqui foi provado a um comprador ainda.</p>
    <div class="bb-scroll" role="region" aria-label="Tabela de critérios e valores" tabindex="0">
      <table class="bb-tab">
        <thead><tr><th>Valor</th><th>O que o comprador recebe</th><th>Critério e medida</th><th>Superação (hipótese)</th><th>Hoje</th></tr></thead>
        <tbody>
          {tabela.map((l) => (
            <tr>
              <th scope="row">{l.valor}</th>
              <td>{l.recebe}</td>
              <td>{l.medida}</td>
              <td>{l.superacao}</td>
              <td><span class={`bb-nivel ${l.nivel}`}>{l.hoje}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="est-selo congelado">classe <b>congelado no tempo</b> · selo D_COMMS_BACKBONE_VALUE_TABLE_1112 (PR #1627) e coluna Superação (PR #1632), 2026-11-12</p>
  </div>
</section>

<section class="est-sec est-sec-alt" id="limites">
  <div class="wrap">
    <span class="est-kick">3 · O que ainda não sei</span>
    <h2>Os limites <em>ficaram escritos</em>.</h2>
    <ul class="bb-lista">
      <li>Se o comprador paga pelas qualidades e pela governança (limite declarado pela curadoria no Delphi).</li>
      <li>O registro de leitura do grafo (limite declarado pela sessão do grafo).</li>
      <li>A fila local não cobre a falha do disco da máquina (ressalva do hub).</li>
      <li>A coluna Hoje, peça por peça, e o veredito sobre o comparável direto, ainda sem selo.</li>
    </ul>
    <p class="est-mais"><a href="/historia/migalhas/">A história desta decisão está nas migalhas de 12 de novembro →</a></p>
  </div>
</section>

</Base>

<style>
  .bb-ordem { list-style:none; padding:0; margin:1.4rem 0 0; display:flex; flex-direction:column; gap:.9rem; max-width:72ch; }
  .bb-ordem li { display:flex; gap:1rem; align-items:flex-start; background:var(--bg-card); border:1px solid var(--border); border-radius:var(--radius); padding:1rem 1.1rem; }
  .bb-n { font-family:var(--display); font-size:1.5rem; color:var(--orange); line-height:1; min-width:1.4rem; }
  .bb-ordem h3 { font-size:1.02rem; margin-bottom:.3rem; }
  .bb-ordem p { font-size:.93rem; color:var(--text-body); }
  .bb-tag { font-family:var(--sans); font-size:.7rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--text-muted); border:1px solid var(--border); border-radius:999px; padding:.1rem .5rem; margin-left:.4rem; vertical-align:middle; }
  .bb-tag.curso { color:var(--orange); border-color:var(--border-warm); }
  .bb-scroll { overflow-x:auto; margin-top:1.4rem; border:1px solid var(--border); border-radius:var(--radius); background:var(--bg-card); }
  .bb-tab { border-collapse:collapse; width:100%; min-width:820px; font-size:.88rem; }
  .bb-tab th, .bb-tab td { text-align:left; vertical-align:top; padding:.75rem .85rem; border-bottom:1px solid var(--border); color:var(--text-body); }
  .bb-tab thead th { font-size:.72rem; letter-spacing:.08em; text-transform:uppercase; color:var(--text-muted); }
  .bb-tab tbody th { color:var(--text); font-weight:700; white-space:nowrap; }
  .bb-tab tbody tr:last-child th, .bb-tab tbody tr:last-child td { border-bottom:none; }
  .bb-nivel { display:inline-block; padding-left:.9rem; position:relative; }
  .bb-nivel::before { content:''; position:absolute; left:0; top:.45em; width:7px; height:7px; border-radius:50%; background:var(--text-muted); }
  .bb-nivel.parcial::before { background:var(--orange-light); }
  .bb-nivel.falta::before { background:var(--purple); }
  .bb-lista { margin:1rem 0 0 1.1rem; max-width:68ch; color:var(--text-body); display:flex; flex-direction:column; gap:.5rem; }
  @media (max-width:640px) { .bb-ordem li { padding:.85rem; } }
</style>
