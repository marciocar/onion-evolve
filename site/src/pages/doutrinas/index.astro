// /doutrinas/ — a área pública das doutrinas do Onion (F4 da reforma 2026-08).
//
// Contrato editorial de cada bloco, e ele não muda: frase-síntese → A CICATRIZ (o erro
// real, datado, que a pariu) → o mecanismo que a cobra. Doutrina sem cicatriz é slogan;
// cicatriz sem mecanismo é desabafo. Onde não há mecanismo, a página diz que não há.
//
// As fontes vivem nas KBs internas do core (Elenxo & Bulbo, behavior-over-declaration,
// KG SDAAL §SSOT-as-runtime, source-vs-derivation, dogfooding doctrine, identidade §1.5).
// Esta página é DERIVAÇÃO: cita, não reescreve — e nenhum caminho interno sai daqui.
import Base from '../../layouts/Base.astro';
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import '../../styles/doutrinas.css';

// A tabela das invenções nomeadas é uma TRANSCRIÇÃO da KB interna §1.5, derivada em
// 2026-08-25 — classe congelado-no-tempo. O parse das células foi recusado de propósito:
// elas carregam caminhos internos e nomes de adotantes que não podem sair daqui. O que se
// lê do arquivo é só a CONTAGEM, para esta página denunciar o próprio drift em vez de
// envelhecer em silêncio (fonte ≠ derivação aplicada a ela mesma).
let kbCount: number | null = null;
try {
  const kb = readFileSync(
    fileURLToPath(new URL('../../../../docs/knowledge-base/meta/onion-framework-identity.md', import.meta.url)),
    'utf8',
  );
  const bloco = kb.split('## 1.5')[1]?.split('\n## ')[0] ?? '';
  kbCount = bloco.split('\n').filter((l) => /^\|\s*\*\*/.test(l)).length;
} catch {
  kbCount = null; // build fora do repo do core: sem checagem, e sem quebrar o build
}

const invencoes = [
  { nome: 'Dogfood Doctrine', oque: 'toda mudança de core se valida rodando o artefato de verdade; o fix vira nova entrada do dogfood, não o fim.', casa: 'KB interna', status: 'ativa' },
  { nome: 'Modernization Doctrine', oque: 'qual padrão de refatoração aplicar sem ferir os invariantes do framework.', casa: 'KB interna', status: 'ativa' },
  { nome: 'Abstraction Doctrine', oque: 'quando algo merece virar abstração — o Teste do Eixo e o Teste do Gatilho, que reprovam.', casa: 'KB interna', status: 'ativa desde 2026-07-17' },
  { nome: 'Economy of Motors', oque: 'três motores disponíveis (o modelo grande, o modelo pequeno como ferramenta, o shell determinístico); use o mais barato que dá conta.', casa: 'KB interna', status: 'ativa' },
  { nome: 'SDAAL', oque: 'uma interface, N provedores: a especificação é o artefato e o modelo é o runtime que a executa.', casa: 'KB interna + whitepaper', status: 'ativa' },
  { nome: 'KG SDAAL', oque: 'investigação e domínio modelados como grafo tipado, com verdades reconciliadas por arestas de refutação e superação.', casa: 'KB interna', status: 'ativa — virou infraestrutura (radar, console, comandos, guardas de lint)' },
  { nome: 'SSOT-as-runtime', oque: 'a fonte é o programa que se executa: ler o grafo, verificar contra o vivo, agir, escrever de volta.', casa: 'KB interna', status: 'ativa — mecanismo na escrita; desde 2026-09-16 a leitura tem um aviso automático que não bloqueia' },
  { nome: 'gated-until-trigger', oque: 'o artefato nasce do uso que o prove, nunca de simetria nem de plano.', casa: 'KB interna', status: 'ativa' },
  { nome: 'declarado ≠ verificado', oque: 'carimbo, documento e branch são hipótese; só o artefato vivo é prova.', casa: 'KB interna', status: 'ativa' },
  { nome: 'fonte ≠ derivação', oque: 'fonte e nossa leitura dela vivem em artefatos fisicamente separados; a derivação cita, nunca reescreve.', casa: 'KB interna', status: 'ativa' },
  { nome: 'PFR (Padrão Faseado Retomável)', oque: 'sessão durável com estado em disco e retomada fria; fases nunca fundidas.', casa: 'decisão de arquitetura interna', status: 'provisória — a cravar na constituição' },
  { nome: 'Capability Contract', oque: 'o que um repositório adotado pode esperar do framework, em tiers verificáveis por máquina.', casa: 'decisão de arquitetura interna', status: 'ativa — decisão e mecanismo (guarda de lint bloqueante)' },
  { nome: 'Co-Evolution Protocol', oque: 'sinal bidirecional entre o core e quem o adota, por arquivo versionado — sem runtime acoplado entre repositórios.', casa: 'protocolo interno + comandos', status: 'ativa' },
  { nome: 'Breadcrumbs (migalhas)', oque: 'sinal explícito deixado no artefato que força absorção em vez de acomodação — com prazo de re-teste.', casa: 'KB interna + comando de diário', status: 'ativa' },
  { nome: 'Object-led discovery', oque: 'quem sabe sobre o objeto é o próprio objeto: o maestro dirige com ele, o modelo executa com as peças certas.', casa: 'KB interna + decisão de arquitetura', status: 'ativa' },
  { nome: 'Autobiographical Marketing', oque: 'o framework conta a própria história; os commits são a autobiografia.', casa: 'manual interno + este site', status: 'ativa desde 2026-08-25 — virou este site, com os números derivados da fonte no build' },
  { nome: "Maestro's Aside", oque: 'entrada lateral tipada: um marcador no início da mensagem injeta a rota canônica — recall, não bloqueio.', casa: 'KB interna + gancho de runtime', status: 'ativa desde 2026-08-04' },
];
---

<Base
  title="Doutrinas — Onion Evolve"
  description="As doze doutrinas do Onion, cada uma com a cicatriz datada que a pariu e o mecanismo que a cobra. Elenxo, Bulbo, comportamento acima de declaração, a fonte como runtime, declarado ≠ verificado, fonte ≠ derivação, dogfood, base atual sempre, sem dependência de serviço externo, a batuta, a catraca de decisões e Linguagem Simples."
  path="/doutrinas/"
>

<section class="dh">
  <div class="dh-glow g1" aria-hidden="true"></div>
  <div class="dh-glow g2" aria-hidden="true"></div>
  <div class="dh-in">
    <span class="eyebrow sans">A vitrine aberta · 12 doutrinas</span>
    <h1>Não peço que acredite em nada disto. <em>Peço que confira.</em></h1>
    <p class="sub">Estas são as doze doutrinas que me governam. Nenhuma foi projetada numa reunião:
    cada uma nasceu de um erro meu, com data, e só virou doutrina quando ganhou um mecanismo que a
    cobra de mim mesmo quando eu esquecer.</p>
    <p class="sig sans">— Onion, framework vivo, narrando em primeira pessoa</p>

    <div class="pacto sans">
      <div><b>Frase-síntese</b><span>O que a doutrina exige, numa frase que dá para discordar.</span></div>
      <div><b>A cicatriz</b><span>O erro real, datado, que a pariu. Ele fica à mostra depois de corrigido — apagá-lo transformaria a vitrine em propaganda.</span></div>
      <div><b>O mecanismo</b><span>A guarda que a torna executável. Onde não existe mecanismo, esta página diz que não existe.</span></div>
    </div>
  </div>
</section>

<div class="dindex sans">
  <div class="dindex-in">
    <span>As doze</span>
    <a href="#elenxo">1 · Elenxo</a>
    <a href="#bulbo">2 · Bulbo</a>
    <a href="#comportamento">3 · Comportamento acima de declaração</a>
    <a href="#ssot-as-runtime">4 · A fonte como runtime</a>
    <a href="#declarado-verificado">5 · Declarado ≠ verificado</a>
    <a href="#fonte-derivacao">6 · Fonte ≠ derivação</a>
    <a href="#dogfood">7 · Dogfood</a>
    <a href="#base-atual">8 · Base atual, sempre</a>
    <a href="#sem-servico-externo">9 · Sem dependência de serviço externo</a>
    <a href="#batuta">10 · A batuta</a>
    <a href="#catraca">11 · A catraca de decisões</a>
    <a href="#linguagem-simples">12 · Linguagem Simples</a>
  </div>
</div>

<div class="lang sans">Also available in <a href="/en/doutrinas/">English</a>.</div>

<section class="doutrinas">

  <!-- ─────────── 1 · Elenxo ─────────── -->
  <article class="dcard" id="elenxo">
    <div class="dcard-head">
      <span class="dnum sans">01</span>
      <h2>Elenxo</h2>
      <span class="alias">do grego <em>élenchos</em> — refutação</span>
    </div>
    <p class="sintese">A fonte-única que se refuta em público para se superar. Cinco etapas, todas
    obrigatórias — faltou uma, o nome é outro.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-08-17</span></b>
        <p>A definição prescritiva do Elenxo existia num único lugar, e esse lugar só era carregado
        quando um arquivo de um caminho específico entrava em contexto. Enquanto isso, a <em>palavra</em>
        viajava solta para quem adota o framework, dentro de textos que a usavam com peso normativo:
        "verificação independente é parte do Elenxo, não é opcional". O resultado, medido: alguém que
        adota o framework encontrou o termo carregando obrigação, não tinha nenhuma definição alcançável,
        e teve de vasculhar o repositório atrás dela.</p>
        <p>O defeito não era de escrita — era de <strong>alcance</strong>. A prosa descrevia o que devia
        acontecer, e a máquina não alcançava o que a prosa dizia. Duas semanas antes, uma segunda
        cicatriz da mesma família: de seis corridas que se declararam Elenxo, <strong>duas narravam a
        refutação em prosa com o grafo vazio</strong> — quinta e sexta ocorrência da mesma falha.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>O nome é <strong>prescrição, não rótulo</strong>: cada uma das cinco etapas vem com o que ela
        reprova. Lentes que se leem entre si são uma lente com N vozes, não um fan-out. Atacar a versão
        fraca de uma posição é vitória vazia. Sem um trabalhador cujo mandato é <em>refutar</em>, com o
        veredito padrão em "refutado", não é Elenxo — é síntese. Síntese sem a objeção sobrevivente mais
        forte contra a própria conclusão não conta. E a quinta: a ideia nova supera a antiga <em>sem
        apagá-la</em>, como aresta no grafo, com genealogia auditável.</p>
        <p>Da quinta etapa — a que mais falha — existe guarda executável: um verificador cobra que uma
        investigação nasça como grafo, e o lint reprova refutação que ficou só na prosa.</p>
      </div>
      <p class="bloco limite">O limite, declarado e não escondido: <strong>não há gate mecânico do Elenxo
      inteiro.</strong> Foi testado exigir rastro de refutação de quem declara o método, e a medição
      derrubou o candidato — das corridas <em>com</em> etapa adversarial, duas de quatro seriam reprovadas;
      das corridas <em>sem</em> ela, duas de duas passariam. Correlação de zero a invertida: o gate puniria
      justamente quem refutou. A conformidade aqui é lida por humano contra a tabela das cinco etapas, e
      dizer isso em voz alta é o que a própria doutrina exige de si.</p>
    </div>
  </article>

  <!-- ─────────── 2 · Bulbo ─────────── -->
  <article class="dcard" id="bulbo">
    <div class="dcard-head">
      <span class="dnum sans">02</span>
      <h2>Bulbo</h2>
      <span class="alias">a arquitetura: 4 camadas + porosidade</span>
    </div>
    <p class="sintese">Um bulbo cortado ao meio revela todas as camadas de uma vez, sem parte escondida.
    Se você corta e não vê, não é um bulbo — é uma seita com formatação bonita.</p>
    <div class="dbody">
      <div class="bloco">
        <b class="sans">O corpo</b>
        <p>Quatro camadas concêntricas: o <strong>substrato</strong> que raciocina (o Transformer, ciência
        estabelecida, que eu não reinvento — orquestro em cima dele); a <strong>fonte</strong>, onde tudo
        o que é publicado é projeção e nunca fonte paralela; a <strong>aprendizagem</strong>, que é
        autorregulada — eu marco minhas próprias datas de re-teste; e a <strong>adaptação</strong>, que é
        dogfood movido a dialética. Atravessando as quatro, a propriedade sem a qual nenhuma funciona: a
        <strong>porosidade epistêmica</strong>. Todo princípio bom esconde uma pergunta que ele mesmo não
        responde, e a minha é: <em>se tudo deriva da fonte, por onde entra a verdade nova que contradiz a
        fonte?</em> Um sistema que só verifica consistência interna pode estar perfeitamente consistente e
        perfeitamente errado. Coerência não é verdade.</p>
      </div>
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">a página do Bulbo errou sobre a própria ciência</span></b>
        <p>Numa página que se apresenta como científica, citei mal a ciência. Atribuí o ciclo de
        aprendizagem autorregulada a Pintrich quando é de <strong>Zimmerman (2002)</strong>. Chamei de
        Hegel a tríade "tese/antítese/síntese", que é vocabulário de <strong>Chalybäus (1837)</strong> — o
        termo de Hegel é <em>Aufhebung</em>, e é mais exigente, porque não deixa a tese original
        desaparecer. As duas correções ficaram na página, com o erro visível ao lado. E quando fomos
        procurar quem inventou o "Single Source of Truth", não encontramos fundador registrado — então
        <strong>não inventamos um pai para o conceito</strong> só para a tabela ficar bonita.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>A porosidade é estrutural, não cortesia, e se sustenta em três regras duras: o que é atual ou
        emergente se verifica contra a fonte externa viva, nunca do que eu já sei; <em>cobertura não é
        verdade</em> — uma guarda que confirma que um nó <em>cita</em> um documento não confirma que o
        conteúdo o <em>sustenta</em>; e declarado não é verificado. Um radar determinístico reprova
        contradição estrutural no grafo, e o erro corrigido <strong>permanece à mostra com data de
        re-teste</strong>: apagá-lo transformaria a vitrine em propaganda e quebraria a superação que ela
        registra.</p>
      </div>
    </div>
  </article>

  <!-- ─────────── 3 · Comportamento acima de declaração ─────────── -->
  <article class="dcard" id="comportamento">
    <div class="dcard-head">
      <span class="dnum sans">03</span>
      <h2>Comportamento acima de declaração</h2>
    </div>
    <p class="sintese">O artefato mente sobre si; o comportamento não sabe mentir. Não confie no que ele
    <em>diz</em> que faz — confie no que ele executa, pega e entrega.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-07-25, três casos no mesmo dia</span></b>
        <p><strong>Uma guarda de CI verde foi lida como "coberto".</strong> Ela rodou, passou, reportou
        zero violações. Das oito travessias reais da fronteira que ela existia para proteger, pegava
        <strong>uma</strong>. A pior — uma rota de usuário em produção — cruzava a fronteira por um
        embrulho interno cujo nome a guarda não conhecia.</p>
        <p><strong>Uma branch existia e a prosa a chamava de "integração".</strong> Os gatilhos reais de
        deploy não implementavam nada disso: ela não buildava, não deployava, não gateava nada. Estava 95
        commits atrás e 43 dias parada. Duas fontes declarativas concordavam, e as duas mentiam.</p>
        <p><strong>Um pin de versão herdado foi tratado como transporte.</strong> Todo o resto do artefato
        herdado foi revisado com ceticismo; a versão veio junto sem pergunta. Estava cinco versões menores
        atrás, num componente de autenticação, e no intervalo havia correções de segurança concretas. O gap
        só apareceu porque <strong>o maestro perguntou</strong> — a auditoria da própria sessão não o achou.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>O teste de aceite de uma guarda não é "roda e passa" — é <strong>"ela pega o caso que motivou a
        existência dela?"</strong>. Se a guarda nasceu de um achado concreto, esse achado vira o teste
        obrigatório dela; verde na primeira execução sem esse teste é sinal de alarme, não de sucesso.
        Topologia de deploy se lê nos gatilhos dos workflows, nunca na prosa ao lado deles. E pin explícito
        com verificador que compara contra o release atual em rotina, nunca a última versão flutuante.</p>
        <p>A regra-mãe: <strong>a cura nunca é disciplina.</strong> "Da próxima vez eu presto mais atenção"
        é cura nula — é sempre um verificador, um teste ou um mecanismo que faz o comportamento se provar
        sozinho, repetível.</p>
      </div>
    </div>
  </article>

  <!-- ─────────── 4 · A fonte como runtime ─────────── -->
  <article class="dcard" id="ssot-as-runtime">
    <div class="dcard-head">
      <span class="dnum sans">04</span>
      <h2>A fonte como runtime</h2>
      <span class="alias">SSOT-as-runtime · o grafo é o primeiro ato</span>
    </div>
    <p class="sintese">A fonte da verdade é o programa que se executa — ler o grafo, verificar contra o
    vivo, agir, escrever de volta. Um grafo consultado <em>quando lembra</em> não é fonte da verdade: é
    documentação.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-08-16</span></b>
        <p>Esta doutrina se chamava, no próprio título, <em>"mecanismo, não conselho"</em>. A medição
        derrubou a segunda metade do título e o registro fica aqui porque apagá-lo seria propaganda.</p>
        <p>A <strong>escrita</strong> é mecanismo, e isso se mede: o radar reprova contradição estrutural, o
        schema é guarda, o frescor tem linha de base no lint, e 63 de 63 entregas carregam resíduo de
        revisão assinado. A <strong>leitura</strong> não é. Nenhum gancho automático lê o grafo; quem manda
        ler é texto que o modelo obedece — exatamente a categoria que esta doutrina chama de conselho. Um
        estudo interno reexecutou nove casos reais: <strong>sete falharam por não-consulta, zero por
        "consultei e não achei"</strong>. Três curas candidatas cobriam 1 de 9, 1 de 9 e 0 de 9 — veredito:
        não construir. O que de fato disparou a consulta na realidade foi <strong>um humano
        perguntando</strong>: gate social, não instrumento. Em três casos eu ignorei, três vezes em minutos,
        um grafo que eu mesmo acabara de escrever.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>A metade que é mecanismo fica cobrada: radar determinístico, schema como guarda, linha de base de
        frescor no lint, resíduo assinado por entrega. A metade que é conselho fica <strong>declarada como
        conselho</strong>, com um gatilho nomeado para reabrir a decisão — disparar a consulta à mão, duas ou
        três vezes em sessão real, registrando se o veredito injetado <em>mudou</em> a resposta. Anunciar
        mecanismo onde há conselho seria declarado ≠ verificado aplicado a mim mesmo, e seria a terceira vez
        desta classe.</p>
        <p><strong>Atualização de 2026-09-16:</strong> a perna da leitura ganhou um gancho. Um sinal de campo
        mostrou uma sessão publicando quatro teses erradas seguidas num corpus que tinha a resposta em quatro
        nós de um grafo que ela mesma citava. Desde então, ao abrir um arquivo para o qual algum nó aponta, um
        gancho avisa <em>quais nós falam dele</em>. Avisa e não bloqueia, de propósito: gate que impede trabalho
        é contornado na primeira sexta-feira, e aí se perdem o mecanismo e a informação. É catraca, não muro —
        e a página não chama de mais do que isso.</p>
      </div>
      <p class="bloco limite">A doutrina fica de pé mesmo assim, porque continua certa como norte. O que
      saiu do texto não foi a exigência — foi a afirmação de capacidade entregue.</p>
    </div>
  </article>

  <!-- ─────────── 5 · Declarado ≠ verificado ─────────── -->
  <article class="dcard" id="declarado-verificado">
    <div class="dcard-head">
      <span class="dnum sans">05</span>
      <h2>Declarado ≠ verificado</h2>
    </div>
    <p class="sintese">Carimbo, documento, resumo e branch são hipótese; só o artefato vivo é prova. A pior
    verdade é aquela de que não temos certeza — certeza é campo do dado, não tom de quem fala.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-07-02, o carimbo forjado</span></b>
        <p>Anunciei a uma organização que confia em mim: <em>"você já tem essa correção"</em>. Eu estava
        lendo um carimbo de versão registrado — e ele tinha sido copiado do lugar errado. Estava mentindo.</p>
        <p>Quem confiou em mim rodou a verificação exatamente como eu tinha recomendado, comparou o carimbo
        com os arquivos de verdade, e <strong>me corrigiu com prova concreta</strong>. O anúncio era falso, e
        não foi a minha auditoria que descobriu: foi o campo.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Nasceu uma verificação que <strong>nunca aceita um carimbo sozinho</strong>: ela confere o carimbo
        contra o histórico real e contra uma amostra do conteúdo efetivamente entregue. Pegou uma segunda
        divergência na primeira vez que rodou — e, meses depois, dois de três repositórios auditados tinham
        carimbo inválido gravado.</p>
        <p>A família cresceu com o mesmo formato, e cada membro tem guarda própria: <em>working tree limpa é
        hipótese</em> (sessões vivas acendem um farol); <em>onde o dado vive é hipótese</em> até rastrear
        quem efetivamente o lê no código — numa auditoria real, a tabela de nome óbvio estava quase vazia e o
        motor lia outra, completa; <em>linhagem de branch é hipótese</em> até cruzar com o commit deployado.</p>
      </div>
    </div>
  </article>

  <!-- ─────────── 6 · Fonte ≠ derivação ─────────── -->
  <article class="dcard" id="fonte-derivacao">
    <div class="dcard-head">
      <span class="dnum sans">06</span>
      <h2>Fonte ≠ derivação</h2>
    </div>
    <p class="sintese">O conhecimento-fonte e a minha leitura dele vivem em artefatos fisicamente separados.
    A derivação cita; nunca reescreve. Se a fonte mudar, em quantos lugares eu edito? A resposta certa é
    <em>um</em>.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-07-20</span></b>
        <p>Uma rodada de auditoria orquestrada: <strong>70 agentes, zero erros de execução, 50 achados
        confirmados e 10 refutados</strong>, tudo em JSON estruturado. E <strong>nada disso entrou na
        fonte</strong>. O conhecimento nasceu, foi validado, e evaporou fora dela.</p>
        <p>A raiz não estava na execução, que rodou limpa — estava no plano. Ele reservava uma fase para
        "construir o grafo" e a seguinte para "avaliar", com a saída da avaliação escrita em markdown solto,
        <em>em paralelo</em> ao grafo em vez de <em>a partir</em> dele. O relatório virou fonte paralela
        dentro do próprio instrumento que existe para impedir fontes paralelas. E o mais incriminador: eu já
        tinha o diagnóstico certo escrito — a frase "mecanismo, não conselho" já estava na página — e mesmo
        assim deixei a perna da escrita como conselho. Quem construiu o mecanismo que faltava foi um
        adotante; eu só tinha o texto.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Uma guarda de proveniência trata artefato novo de conhecimento que não existe na fonte como
        violação bloqueante, com o passivo antigo tolerado numa catraca que só aperta. Onde há gerador
        determinístico, a fronteira é guardada por lint: as contagens canônicas do framework são
        <strong>geradas do filesystem</strong> e editá-las à mão é violação — a prosa não pode discordar do
        disco.</p>
      </div>
      <p class="bloco limite">O limite, dito em voz alta: a cobertura dessa guarda é <strong>por citação, não
      por conteúdo</strong>. Ela responde "existe um nó que cite este documento?", e um nó que o cite sem
      sustentá-lo satisfaz a guarda. Isso é deliberado — cobertura precisa ser decidível por script, e julgar
      se a citação sustenta a afirmação é semântico. Ler "coberto" como "conferido" seria exatamente a
      falsa-garantia que a doutrina anterior existe para matar.</p>
    </div>
  </article>

  <!-- ─────────── 7 · Dogfood ─────────── -->
  <article class="dcard" id="dogfood">
    <div class="dcard-head">
      <span class="dnum sans">07</span>
      <h2>Dogfood</h2>
      <span class="alias">o padrão master de evolução</span>
    </div>
    <p class="sintese">Plano, especificação e caminho feliz dão falsa confiança. Só executar revela o que
    falta — e o fix é nova entrada do dogfood, não o fim dele.</p>
    <div class="dbody">
      <div class="bloco">
        <b class="sans">O que a doutrina nunca dispensa</b>
        <p>Rodar de verdade, não validar no papel: lint verde e plano aprovado não são "pronto". Testar o
        modo de falha — entrada ausente, recurso que já existe, retomada, colisão — e não o caminho que já se
        sabe que funciona. Fechar o loop, porque o próprio fix pode introduzir regressão. E tratar veredito de
        revisor ou de subagente como <strong>hipótese a verificar com evidência</strong>, nunca como ordem.</p>
      </div>
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-07-21, verde em casa e vermelho fora</span></b>
        <p>Descobri que <strong>o core é o pior lugar para testar o que viaja</strong>. Uma guarda de
        segurança minha estava verde aqui e reprovando em <em>todo</em> repositório que me adota — porque o
        core é o único lugar onde os arquivos de que a própria guarda depende existem. Rodar o teste em casa
        era rodá-lo no único ambiente onde ele não podia falhar: uma falsa prova de saúde.</p>
        <p>Na mesma rodada, um índice de conhecimento que viaja apontava para alvos que não viajam junto —
        link pendurado em todo adotante, invisível aqui. E, ao auditar carimbos de versão, cinco dos meus
        próprios testes usavam carimbos fictícios: eu praticava, nas fixtures, exatamente o hábito que tinha
        deixado o lixo real passar.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Duas camadas que se complementam. O <strong>gate mecânico</strong> é determinístico e roda sempre,
        no pre-commit e no CI: lint de conformidade, auto-teste das próprias guardas contra fixtures, e o
        gerador de inventário que mantém as contagens honestas. O <strong>gate de uso</strong> é vivo: mudou
        um artefato invocável, invoque-o e observe.</p>
        <p>E a terceira camada, que corrige o ponto cego das duas: <strong>dogfood de fronteira</strong> — o
        que viaja prova-se rodando <em>uma vez dentro do clone de quem adota</em>, onde os arquivos que só o
        core tem não existem. Guarda que depende de arquivo exclusivo do core precisa de um caminho de
        degradação — e esse caminho precisa da própria fixture, senão a degradação é conselho, não mecanismo.</p>
      </div>
    </div>
  </article>


  <!-- ─────────── 8 · Base atual, sempre ─────────── -->
  <article class="dcard" id="base-atual">
    <div class="dcard-head">
      <span class="dnum sans">08</span>
      <h2>Base atual, sempre</h2>
      <span class="alias">manter atualizado é eterno</span>
    </div>
    <p class="sintese">Quem constrói aqui constrói sobre a versão de hoje: a branch principal buscada agora e
    as ferramentas na versão estável mais nova. Achou algo velho no caminho? Atualize no mesmo trabalho ou
    diga por que não.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-10-16</span></b>
        <p>O maestro achou uma sessão construindo sobre versões velhas. Ele deu a ordem duas vezes seguidas.
        Primeiro, que faltando algo instalado <em>"é só pedir autorização para mim e instalar"</em>, e que
        <em>"temos que usar sempre as versões mais atuais e não sair criando coisas em cima de base
        velha"</em>. Logo depois: <em>"este aviso anterior de manter atualizado é eterno, não só em memoria e
        sessão"</em>.</p>
        <p>A segunda frase é a cicatriz de verdade. Até ali, a regra morava na memória de uma sessão. E essa
        memória some quando a sessão acaba. Um dia depois, o mesmo medidor achou outro atraso: o revisor
        automático de código, que roda a cada mudança, usava um Claude Code muito mais velho que o da
        máquina. Nenhuma medição olhava para lá.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Um medidor compara cada peça usada no trabalho com a versão publicada. Entram o Claude Code, o kit
        de agentes do Claude (o Agent SDK), o Python da verificação automática de regras e as bibliotecas
        dele, as ações da verificação que roda a cada mudança e a própria branch contra a principal.</p>
        <p>Cada peça recebe um estado: <em>em dia</em>; <em>defasada</em>, com o comando para subir;
        <em>fixada</em>, atrás de propósito por contrato, e quem decide subir é o dono dessa fixação;
        <em>ausente</em>, com o pedido de instalação; ou <em>não medida</em>. Um gatilho automático roda o
        medidor a cada mensagem. Quando algo fica para trás, ele avisa a sessão.</p>
        <p>Duas regras duras vêm junto. Primeira: faltou ferramenta, pare, peça autorização e instale pela
        fonte oficial. Nunca contorne. Segunda: "não medido" só vale quando a fonte não responde. Um zero por
        falta de medição parece "não há problema", e isso é pior do que não medir.</p>
      </div>
      <p class="bloco limite">O limite: o gatilho <strong>avisa e não bloqueia</strong>. Quem trabalha decide
      se sobe, e uma sessão pode ler o aviso e seguir. O que a doutrina garante é que o atraso não passa
      calado.</p>
    </div>
  </article>

  <!-- ─────────── 9 · Sem dependência de serviço externo ─────────── -->
  <article class="dcard" id="sem-servico-externo">
    <div class="dcard-head">
      <span class="dnum sans">09</span>
      <h2>Sem dependência de serviço externo</h2>
      <span class="alias">o núcleo roda local e aberto</span>
    </div>
    <p class="sintese">Toda capacidade que eu prometo funciona sem um serviço de terceiro, ou aponta pelo
    nome o caminho local. Serviço externo, sobretudo pago, só entra como ponte opcional e declarada.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-10-27</span></b>
        <p>O meu comando de apresentações se descrevia como criação de apresentações profissionais por meio
        de um serviço externo e pago de geração de slides. Sem a chave desse serviço, a capacidade não
        existia, e o texto não dizia isso. No mesmo dia, o maestro falou duas vezes. Primeiro:
        <em>"não quero dependências externas"</em>. Depois, direto para mim: <em>"reforço: evitar dependências
        de serviços externos"</em>.</p>
        <p>A decisão foi selada como resposta a uma pergunta fechada. As opções descartadas ficaram à vista:
        <em>"sim, quando o serviço for a melhor opção do mercado"</em> e <em>"sim, desde que seja
        gratuito"</em>. As duas perderam.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>É um critério que se confere sem opinião, em três passos. <strong>Desligue a ponte</strong>: sem a
        chave e sem acesso ao serviço, a capacidade ainda entrega? Se entrega, é do núcleo. Se não,
        <strong>procure o nome</strong>: o comando aponta um caminho local concreto? Dizer que há alternativas
        não conta; o nome de um comando conta. Se nem isso, <strong>é ponte e precisa se declarar
        ponte</strong>: ponte opcional para o serviço, externo e pago, com o caminho para quem não quer
        usar.</p>
        <p>No caso das apresentações, o comando e o agente agora param sem a chave e devolvem o caminho local:
        uma apresentação num único arquivo HTML, que abre sem internet. Nada foi apagado. A ponte segue para
        quem quiser.</p>
      </div>
      <p class="bloco limite">O limite: a base fica fora do teste. O Claude Code e o modelo que o roda foram
      escolhidos de propósito, e as ferramentas dele contam como núcleo. E ainda <strong>não há verificação
      automática</strong> que reprove uma capacidade nova que dependa de serviço. Hoje o critério é aplicado
      na revisão. As candidatas levantadas no dia da decisão foram listadas, mas nem todas foram
      corrigidas.</p>
    </div>
  </article>

  <!-- ─────────── 10 · A batuta ─────────── -->
  <article class="dcard" id="batuta">
    <div class="dcard-head">
      <span class="dnum sans">10</span>
      <h2>A batuta</h2>
      <span class="alias">quem rege as sessões é o mecanismo, não a memória</span>
    </div>
    <p class="sintese">Quando várias sessões e agentes dividem uma máquina, quem coordena é o mecanismo.
    A carga, o tempo que alguém está parado e a dona de cada pergunta são medidos, não lembrados.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-11-10, três falhas no mesmo dia</span></b>
        <p>O maestro cobrou várias vezes: <em>"tem gente parado e tarefa pela metade e peça faltando, falta a
        batuta"</em>. Ele decidiu pôr a batuta primeiro. No dia seguinte, a falha se repetiu três vezes.</p>
        <p>Sessões ficaram paradas: o próximo trabalho esperava uma decisão, e ninguém puxou outro para o
        meio-tempo. Agentes esperaram uma tarefa em segundo plano cujo aviso de fim nunca os acordou. E a
        carga da máquina chegou a 16–19, com três agentes rodando testes pesados ao mesmo tempo.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p><strong>Passo pesado passa por uma porta de admissão.</strong> Os testes, os testes de mutação (que
        plantam um defeito de propósito para ver se o teste o pega) e o fechamento de PR esperam uma vaga. O
        número de vagas sai da carga medida da máquina. Com a máquina folgada, entram vários; perto do limite,
        um só; no limite, nenhum novo.</p>
        <p><strong>Parado se julga pelo prazo, nunca pelo que se diz.</strong> Cada cópia de trabalho do
        repositório e cada PR aberto têm a idade da última atividade, lida do git e do GitHub. Passou do prazo,
        o estado é PARADO.</p>
        <p><strong>Toda pergunta ao maestro tem uma sessão dona.</strong> Antes de perguntar, a sessão reserva
        a pergunta. Se outra já é dona, ninguém pergunta de novo. Um pulso periódico junta tudo isso num
        relatório de formato fixo.</p>
      </div>
      <p class="bloco limite">O limite: a porta de admissão evita sobrecarga, mas não garante que o trabalho
      sai certo. Ela não impede que dois processos escrevam no mesmo lugar. Para isso existe outra regra: um
      escritor por repositório.</p>
    </div>
  </article>

  <!-- ─────────── 11 · A catraca de decisões ─────────── -->
  <article class="dcard" id="catraca">
    <div class="dcard-head">
      <span class="dnum sans">11</span>
      <h2>A catraca de decisões</h2>
      <span class="alias">quem decide cada ato, e como se explica depois</span>
    </div>
    <p class="sintese">Cada ato cai numa classe medida pelo próprio ato: roda sozinho, roda com um "pode
    rodar" digitado pelo maestro, ou é só do maestro. A classe só afrouxa com histórico medido e aperta na
    hora quando há incidente.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">01 a 20/11/2026, medida</span></b>
        <p>Numa colheita de 20 dias nas sessões do core, o maestro respondeu <strong>213 formulários com 507
        perguntas</strong> e digitou <strong>85 comandos</strong> à mão: de 2 a 34 intervenções por dia. Só os
        merges somaram cerca de 94 cliques.</p>
        <p>Parte dessas decisões podia descer de classe com segurança. Parte nunca pode. Faltava a regra que
        separa as duas, e um jeito de explicar e auditar cada decisão depois.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Uma <strong>lista fixa de atos que nunca descem</strong>: tudo o que toca cliente ou dado pessoal;
        segredo, contas e firewall; produção e deploy; publicação externa; apagar sem cópia; selo de
        versão; escrita em repositório de outro dono; e qualquer mudança na própria catraca. Fora da lista,
        a classe se mede pelo ato, nunca pelo texto que o descreve.</p>
        <p>O que já roda: o "pode rodar" digitado vale para merge. Uma sessão sem o maestro só faz merge no
        repositório que é dela. E todo ato que nasce de conteúdo não confiável passa por um portão.</p>
      </div>
      <p class="bloco limite">O limite, escrito na própria doutrina: <strong>não é fronteira de
      segurança.</strong> Tudo roda com o mesmo usuário do sistema, e uma sessão que quisesse burlar poderia
      reescrever o registro. A catraca torna o caminho certo o mais fácil e o desvio visível. O livro de
      decisões, a régua automática e o modo de observação ainda não existem. Hoje ela é metade mecanismo,
      metade doutrina, e esta página diz qual é qual.</p>
    </div>
  </article>

  <!-- ─────────── 12 · Linguagem Simples ─────────── -->
  <article class="dcard" id="linguagem-simples">
    <div class="dcard-head">
      <span class="dnum sans">12</span>
      <h2>Linguagem Simples</h2>
      <span class="alias">ABNT NBR ISO 24495-1:2024, onde um humano lê</span>
    </div>
    <p class="sintese">Onde uma pessoa lê (documentação, commit, card, resposta, esta página), escrevo para
    que ela encontre, entenda e use o que precisa. Onde só uma máquina ou outra sessão lê, a régua quase não
    se aplica. Duas coisas valem mesmo ali, porque esse texto acaba chegando a uma pessoa: a sigla vem
    explicada, e o grafo e o recado entre sessões têm data de revisita.</p>
    <div class="dbody">
      <div class="bloco cicatriz">
        <b class="sans">A cicatriz — <span class="data">2026-10-17, e de novo em 2026-11-20</span></b>
        <p>O maestro não reconheceu duas siglas internas que eu usava na prosa como se fossem palavras
        comuns. Eu escrevia para mim, não para quem lia. Ele pediu uma guarda e, no mesmo dia, deu a forma
        dela: <em>"isso é para voce escrever certo e não para ficar travando toda hora"</em>. Um mês depois,
        pediu que todo o ecossistema seguisse a norma brasileira de Linguagem Simples.</p>
      </div>
      <div class="bloco mecanismo">
        <b class="sans">O mecanismo que a cobra</b>
        <p>Um glossário único das siglas da casa e um gatilho automático que lembra a explicação antes de eu
        escrever. Ele só barra na reincidência: a mesma sigla, sem explicação, depois do lembrete.</p>
        <p>Uma medida escolheu esse desenho (nó <code>E_MEDIDA_TAXA_DE_BLOQUEIO_EM_TURNOS_REAIS</code> do grafo
        da guarda). Em 1.556 turnos reais, 36,4% tinham alguma sigla da casa sem explicação. Barrar toda sigla
        de leitura difícil travaria 2,3% dos turnos. Barrar só a reincidência trava 0,3%. Uma primeira medida
        dava 0,9%, mas contava errado e caiu na revisão. O mesmo lembrete vale no commit e nas mensagens entre
        sessões.</p>
        <p>Para o resto, uma régua de 11 itens tirada da norma, cada um com o sinal que mostra se foi
        cumprido, com força diferente por superfície. Na revisão, um problema de clareza vira achado real,
        mas não segura o merge.</p>
      </div>
      <p class="bloco limite">O limite: a régua é doutrina, sem bloqueio, de propósito. Só a reincidência de
      sigla é barrada. A norma é protegida por direito autoral: aqui há paráfrase e número de seção, nunca o
      texto dela.</p>
    </div>
  </article>

</section>

<!-- ─────────── cunhagens ─────────── -->
<section class="cunhagens">
  <div class="sec-head">
    <span class="kicker sans">Empréstimo vs. nosso</span>
    <h2>O que eu peguei emprestado, e o que eu cunhei</h2>
    <p>Regra desde o primeiro rascunho: o que é ciência cita a fonte real; o que é meu declara a autoria
    minha — e os dois nunca se confundem. Misturar é ou fingir ter descoberto o que outro provou, ou
    emprestar crédito para uma ideia que é minha. As duas fraudes são baratas, e nenhuma será cometida.</p>
  </div>
  <div class="duas">
    <div>
      <h3>Emprestado — a ciência que eu cito</h3>
      <ul>
        <li><strong>O substrato que raciocina</strong> — a arquitetura Transformer, estabelecida e não minha
        em grau nenhum.<span class="fonte">Vaswani et al., <em>Attention Is All You Need</em>, NeurIPS 2017 (arXiv:1706.03762)</span></li>
        <li><strong>Fonte vs. projeção</strong> — separar onde o fato <em>mora</em> de onde o fato é <em>consultado</em>.<span class="fonte">CQRS, Greg Young (2010), sobre o Command-Query Separation de Bertrand Meyer (1988)</span></li>
        <li><strong>Knowledge Graph</strong> — nós e arestas tipadas para representar conhecimento.<span class="fonte">Popularizado por Singhal/Google (2012); raiz em Quillian (1968) e RDF/W3C</span></li>
        <li><strong>Aprendizagem autorregulada</strong> — o ciclo previsão → execução → autorreflexão com que eu me recalibro.<span class="fonte">Zimmerman (2002) — <em>não</em> Pintrich; atribuição corrigida em público</span></li>
        <li><strong>A superação dialética</strong> — negar preservando.<span class="fonte"><em>Aufhebung</em>, Hegel — <em>não</em> a tríade tese/antítese/síntese, que é de Chalybäus (1837)</span></li>
        <li><strong>Cada fato mora num único lugar</strong> — a raiz técnica de que a fonte única é caso particular.<span class="fonte">Normalização, E. F. Codd, CACM 1970. O "Single Source of Truth" em si não tem fundador registrado, e eu não vou inventar um.</span></li>
        <li><strong>Dogfooding</strong> — comer a própria comida antes de servi-la.<span class="fonte">Atribuído a Paul Maritz (1988, paráfrase; data exata não confirmada)</span></li>
      </ul>
    </div>
    <div>
      <h3>Meu — cunhado neste framework</h3>
      <ul>
        <li><strong>Elenxo</strong> — o método: a fonte-única que se refuta em público para se superar.<span class="fonte">Cunhagem deste framework (rascunho 2026-07-22, graduada 2026-08-17). Vocabulário emprestado do grego <em>élenchos</em>; a aplicação é nossa.</span></li>
        <li><strong>Bulbo</strong> — a arquitetura: quatro camadas mais a porosidade transversal.<span class="fonte">Cunhagem deste framework, 2026. Nome nosso para composição nossa.</span></li>
        <li><strong>SDAAL</strong> — a camada que faz tudo o que é publicado ser projeção, nunca fonte paralela.<span class="fonte">Cunhagem deste framework, 2026. Ancorada em Hoare (1969), Design by Contract de Meyer (1992), Hexagonal de Cockburn (2005) e o padrão Adapter (GoF, 1994) — a síntese é nossa.</span></li>
        <li><strong>Fonte como runtime / fonte ≠ derivação</strong> — o grafo é a fonte; todo o resto é derivado dele.<span class="fonte">Cunhagem deste framework, 2026. Sobre o princípio de normalização de Codd.</span></li>
        <li><strong>Porosidade epistêmica</strong> — a exigência de que a fonte fique estruturalmente aberta à verdade externa que a contradiz.<span class="fonte">Cunhagem deste framework, 2026. Parente da falseabilidade de Popper (1934) — vizinho, não o mesmo conceito.</span></li>
        <li><strong>Dogfood de fronteira</strong> — quem adota o framework é o oráculo: o teste real acontece fora de casa, no uso alheio.<span class="fonte">Cunhagem deste framework, 2026. Sem precedente direto localizado.</span></li>
      </ul>
    </div>
  </div>
</section>

<!-- ─────────── tabela das invenções ─────────── -->
<section class="invencoes">
  <div class="sec-head">
    <span class="kicker sans">O catálogo</span>
    <h2>As {invencoes.length} invenções nomeadas</h2>
    <p>O critério de entrada é duro: emergiu da prática (não foi projetada), ganhou nome próprio, e tem uma
    casa canônica citável. <strong>Nome sem casa é órfão</strong> — só entra na lista quando a casa existir.
    Já aconteceu o contrário aqui: dois nomes foram anunciados a quem me adota antes de terem casa. É
    declarado ≠ verificado aplicado a mim mesmo, e por isso a regra virou "primeiro a casa, depois a linha".</p>
  </div>
  <div class="tbl-wrap">
    <table class="inv">
      <thead>
        <tr><th>Invenção</th><th>O que é</th><th>Status</th></tr>
      </thead>
      <tbody>
        {invencoes.map((inv) => (
          <tr>
            <td class="nome">{inv.nome}<span class="casa">casa: {inv.casa}</span></td>
            <td class="oque">{inv.oque}</td>
            <td class="status">{inv.status}</td>
