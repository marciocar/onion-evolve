---
// HOME — portada VERBATIM do legado site/index.html (redesign "PROVA VIVA", jul/2026).
// Conteúdo derivado da identity KB (SSOT) + members.yaml + inventário — fonte≠derivação.
//
// O QUE MUDOU do legado (e por quê):
//   · nav → vive no Base.astro (a canônica tem 6 entradas; o legado tinha 8)
//   · números de INVENTÁRIO → vêm do site-stamp (classe inventario-vivo), nunca hand-coded
//   · números CONGELADOS (448 PRs, 951 commits, membros/linhagens) → texto + carimbo de data
//   · faixa "🍞 As migalhas" → render da coleção (o legado tinha 4 posts hand-coded, drifted)
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { inventario } from '../lib/stamp';
import { ticker, prova } from '../lib/vitrines';
import SecaoDemissao from '../components/SecaoDemissao.astro';
import SecaoSuperficies from '../components/SecaoSuperficies.astro';
import '../styles/home.css';

const inv = inventario();
// Vitrines projetadas do grafo (build valida a seleção contra pr-decision-history.kg.yaml)
const tickerItems = ticker();
const provaCards = prova();
const ultimas = (await getCollection('migalhas'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
const iso = (d: Date) => d.toISOString().slice(0, 10);

// O corpo do terminal é `white-space:pre-wrap`: ali as quebras de linha SÃO conteúdo.
// O compressHTML do Astro colapsaria a linha em branco entre os dois blocos, então
// ele entra por set:html — verbatim, byte a byte com o legado.
const terminal = `
<span class="tl-p">$</span> "organiza este projeto do jeito certo"
<span class="tl-ok">✓</span> projeto novo — nada quebra, nada muda no que já existe
<span class="tl-ok">✓</span> instala tudo numa pasta só (<code>.claude/</code>) — papéis, regras, um jeito único de trabalhar
<span class="tl-ok">✓</span> cada decisão fica registrada — ninguém recomeça do zero amanhã

<span class="tl-p">$</span> "quero um relatório em PDF exportável"
<span class="tl-mut">→</span> primeiro escreve o que precisa acontecer — só depois vem o código
<span class="tl-mut">→</span> o plano fica salvo — você retoma exatamente daqui quando quiser`;

// Terminal do hero — o histórico de decisões (o porquê, não só o quê). Mesma técnica
// set:html do terminal acima: aqui as quebras de linha SÃO conteúdo (white-space:pre-wrap).
const heroTerm = `
<span class="p">›</span> "por que migramos o billing?" — decisão de 8 meses atrás
<span class="ok">✓</span> o <span class="c">porquê</span>, as alternativas descartadas, quem decidiu — do grafo
<span class="ar">→</span> um documento guardaria o QUÊ. o Onion guarda o <span class="c">PORQUÊ</span>.
<span class="ar">→</span> ninguém re-litiga a decisão nem repete o erro — mesmo sem quem decidiu

<span class="p">›</span> # verificado por mecanismo. nenhum LLM adivinhou. você audita.`;
---

<Base
  title="Onion Evolve — o conhecimento da sua empresa, um ativo que você audita"
  description="O Sistema Onion transforma o histórico de decisões da empresa num grafo vivo e verificável — o cérebro operacional (Company Brain / Second Brain) de onde saem código, compliance e produto, com trilha auditável. Verificado por mecanismo, não por palpite de IA."
  path="/"
>

<section class="hero">
  <div class="hero-aura" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>
  <div class="hero-in">
    <span class="badge"><span class="pulse" aria-hidden="true"></span> Second Brain · Company Brain — o cérebro operacional da empresa</span>
    <h1>Seu maior ativo é o <span class="hl">conhecimento</span>.<br>E ele mora na <span class="hl2">cabeça das pessoas</span>.</h1>
    <p class="sub"><strong>Documento guardado não é decisão guardada.</strong> O que vira lenda quando alguém sai é
    o <strong>porquê</strong> — o histórico de decisões. O <strong>Sistema Onion</strong> transforma isso num
    <strong>grafo vivo e verificável</strong>: o cérebro operacional de onde sai código, compliance e produto —
    com trilha que você <strong>audita</strong>, não um palpite de IA.</p>
    <div class="hero-ctas">
      <a class="btn btn-p" href="/mini/">▶ Ver funcionando no seu repo · 5 min</a>
      <a class="btn btn-s" href="#prova">A prova viva ↓</a>
    </div>
    <p class="hero-note">Todo mundo promete um "Company Brain". A diferença: o seu você <strong>audita</strong> — a
    verdade é conferida por mecanismo, não por mais um palpite de IA, e ele prova a própria disciplina rodando de
    verdade, em público.</p>
    <div class="hero-term" role="img" aria-label="O histórico de decisões respondendo o porquê">
      <div class="ht-bar"><i></i><i></i><i></i><span>o histórico de decisões — o porquê, não só o quê</span></div>
      <div class="ht-body" set:html={heroTerm}></div>
    </div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track" id="tick">
    {tickerItems.map((t) => (
      <span><b>#{t.n}</b> {t.text}</span>
    ))}
  </div>
</div>

<section class="sec sec-alt" id="prova">
  <div class="wrap">
    <div class="prova-head reveal">
      <span class="kick">⭐ A prova viva</span>
      <h2>Não pedimos que você confie.<br><em>Aqui está a trilha — datada, e uma vez refutada em público.</em></h2>
      <p class="lead" style="margin:0 auto">Cada decisão abaixo é real: o erro, o porquê que ele revelou e a lei
      que virou — registrados e datados no git no mesmo dia. Um projeto que me adotou chegou a <b>me refutar com
      evidência</b>. Isto é o histórico de decisões funcionando como prova — não um changelog encenado.</p>
    </div>
    <div class="cases">
      {provaCards.map((c, i) => (
        <article class="case reveal">
          <div class="case-date">{c.date} · {c.titulo}{i === provaCards.length - 1 ? ' — hoje' : ''}</div>
          <div class="case-body">
            <div class="step"><span class="t t-err">ERRO</span><span>{c.erro}</span></div>
            <div class="step"><span class="t t-apr">APRENDIZADO</span><span>{c.aprendizado}</span></div>
            <div class="step"><span class="t t-lei">LEI</span><span>{c.lei}</span></div>
          </div>
          <div class="case-pr"><a href="/historia/migalhas/provas/">PR #{c.n} · auditável →</a></div>
        </article>
      ))}
    </div>
    <div class="migs reveal">
      <div class="migs-head">
        <h3>🍞 As migalhas</h3>
        <span class="migs-sub">o diário de aprendizado — cada lição com data de validade e gatilho de re-teste</span>
      </div>
      <ul>
        {ultimas.map((m) => (
          <li><time>{iso(m.data.date)}</time><a href={`/historia/migalhas/#post-${m.data.slug}`}>{m.data.title}</a></li>
        ))}
      </ul>
      <a class="migs-all" href="/historia/migalhas/">Todas as migalhas + RSS →</a>
    </div>
    <p class="prova-stamp reveal">nenhum changelog encenado — tudo commitado e datado no git; a trilha é pública, a decisão é auditável</p>
  </div>
</section>

<section class="sec" id="problema">
  <div class="wrap reveal">
    <span class="kick">O problema</span>
    <h2>A IA acelerou seu time.<br><em>E deixou seu maior ativo exposto.</em></h2>
    <p class="lead">O conhecimento que decide o rumo da empresa não vive num sistema — vive na cabeça das
    pessoas e no scroll de mil chats com a IA. Some quando alguém sai, e ninguém reconstrói o porquê.</p>
    <div class="pains">
      <div class="pain"><span class="x">DOR 01</span><h3>O conhecimento mora na cabeça das pessoas</h3><p>Quando o sênior sai, a decisão vira lenda. O porquê de cada escolha vai embora com ele.</p></div>
      <div class="pain"><span class="x">DOR 02</span><h3>Documento não é decisão</h3><p>O wiki guarda o QUÊ. O PORQUÊ — as alternativas, o que se descartou e por quê — não está em lugar nenhum.</p></div>
      <div class="pain"><span class="x">DOR 03</span><h3>Cada um usa a IA de um jeito</h3><p>Nenhuma trilha, nenhuma consistência entre squads. O que funcionou num time ninguém repete no outro.</p></div>
      <div class="pain"><span class="x">DOR 04</span><h3>Não dá para auditar o que a IA fez</h3><p>Shadow AI, risco regulatório. Quando o auditor pergunta "por que decidiram assim?", não há trilha para mostrar.</p></div>
    </div>
  </div>
</section>

<SecaoDemissao />

<section class="sec sec-alt" id="resposta">
  <div class="wrap reveal">
    <span class="kick">A resposta</span>
    <h2>Do produto ao compliance,<br>uma disciplina só — e uma regra que não se negocia.</h2>
    <p class="lead">O ciclo inteiro — produto, engenharia e <em>compliance como par</em> — para a decisão ficar
    registrada em cada etapa, não só no código. {inv.comandos} comandos, {inv.agentes} agentes e {inv.skills} skills
    de orquestração, sem mudar uma linha do que você já tem.</p>
    <div class="dims">
      <div class="dim"><span class="ico" aria-hidden="true">🎯</span><h3>Produto</h3><p>Da descoberta ao backlog: dores viram specs com critérios de aceite testáveis — sincronizadas no seu task manager (Jira, ClickUp, Asana, Linear) por uma única abstração.</p></div>
      <div class="dim"><span class="ico" aria-hidden="true">⚙️</span><h3>Engenharia</h3><p>Do plano ao PR: workflows faseados e retomáveis — feche o laptop na terça, a sessão continua na quarta do exato ponto em que parou.</p></div>
      <div class="dim"><span class="ico" aria-hidden="true">🛡️</span><h3>Compliance</h3><p>ISO 27001, SOC2, PMBOK e ISO 22301 no mesmo ciclo — documentação de conformidade gerada do estado real, não de um template morto.</p></div>
    </div>
    <div class="goldrule reveal">
      <span class="n">Regra de Ouro</span>
      <p><b>Nunca gerar código antes da especificação.</b> Produto especifica, engenharia planeja, só então
      se codifica — e um guardião anti-bypass avisa quando alguém tenta pular a fila.</p>
    </div>
  </div>
</section>

<section class="sec" id="verticais">
  <div class="wrap reveal">
    <span class="kick">Como eu cresço</span>
    <h2>Nada aqui entra por roadmap.<br><em>Só quando um uso real prova que precisa.</em></h2>
    <p class="lead">Sem features de vitrine: cada capacidade nasce quando o uso real exige. Produto, Engenharia e Compliance são fundadoras; Investigação (o grafo que virou o motor de verificação) e Educação nasceram de evidência, na mesma semana — do jeito que tudo aqui nasce.</p>
    <div class="dims" style="margin-top:1.4rem">
      <div class="dim" style="border-top-color:var(--purple)">
        <span class="ico" aria-hidden="true">🔍</span>
        <h3>Investigação</h3>
        <p>Nasceu do próprio dogfood: modelei minha auditoria como grafo de conhecimento (claims, evidências, arestas <code>SUPPORTS</code>/<code>REFUTES</code>) — e só então o comando <code>/meta:kg</code> existiu. Hoje eu não <em>leio</em> minha documentação: eu <em>navego</em> um grafo, com radar determinístico apontando contradição e órfão.</p>
      </div>
      <div class="dim" style="border-top-color:var(--green)">
        <span class="ico" aria-hidden="true">🎓</span>
        <h3>Educação</h3>
        <p>Nasceu de trabalho real: Marcio já ensinava Spec-as-Code em consultoria e capacitação; o Pulse Mais (pulsemais.org.br) me tornou vertical oficial. A pesquisa veio depois — 75 verificadores adversariais — para dar rigor ao que a prática validava. Batizei a prática de <b>Descasca</b>; a doutrina, de <b>Método Onion</b>. <a href="/pulse-mais/">Ver os materiais do aluno →</a></p>
      </div>
    </div>
  </div>
</section>

<section class="sec sec-alt" id="metodos">
  <div class="wrap reveal">
    <span class="kick">Métodos com nome próprio</span>
    <h2>Não são features.<br><em>São doutrinas — nascidas de cicatriz.</em></h2>
    <p class="lead">Cada nome abaixo nasceu de um erro real, como os da seção anterior. Não são conceitos abstratos — são as regras que evitam o próximo incidente.</p>
  </div>
  <div class="wrap reveal" style="margin-top:2.2rem">
    <div class="methods">
      <div class="method"><h3>Dogfood Doctrine</h3><p>Toda mudança no framework se valida executando o artefato de verdade — inclusive contra si mesmo.</p></div>
      <div class="method"><h3>Declarado ≠ Verificado</h3><p>Nenhum carimbo, status ou tabela é aceito como fato sem o artefato que o comprove. Guardas determinísticas fazem a cobrança.</p></div>
      <div class="method"><h3>SDAAL — o adapter do Transformer</h3><p>O contrato que deixa a IA <b>intercambiar ações</b> com qualquer sistema externo sem reaprender nada: a spec define O QUÊ, o adapter resolve O COMO — task manager, forge, grafo e federação inteira.</p></div>
    </div>
    <p style="text-align:center;margin-top:1.4rem"><a class="mentor-link" href="/doutrinas/">Ver as 8 doutrinas com nome próprio →</a></p>
  </div>
</section>

<section class="sec" id="numeros">
