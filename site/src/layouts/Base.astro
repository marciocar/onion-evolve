---
// Layout base — o chrome único de todas as páginas (F1 da reforma 2026-08).
// A nav canônica tem 6 entradas (decisão do plano: 8→6; Provas via Migalhas,
// "O grafo" absorvido por /maquinaria/).
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** caminho canônico da página, ex.: "/historia/" */
  path?: string;
  /** língua da página. pt-BR é a casa; 'en' só nas páginas-chave compartilháveis. */
  lang?: 'pt-BR' | 'en';
}
const { title, description, path = '/', lang = 'pt-BR' } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const en = lang === 'en';

// A nav troca de rótulo, não de estrutura: as entradas que NÃO têm par em inglês
// continuam apontando para o pt-BR (é a casa). Só onde a versão EN existe o link muda.
const nav = en
  ? {
      tagline: 'the autobiography of a living framework',
      links: [
        { href: '/historia/', label: 'Story' },
        { href: '/historia/migalhas/', label: 'Breadcrumbs' },
        { href: '/en/doutrinas/', label: 'Doctrines' },
        { href: '/en/maquinaria/', label: 'Machinery' },
        { href: '/estado/', label: 'State' },
      ],
      cta: 'Start',
    }
  : {
      tagline: 'a autobiografia de um framework vivo',
      links: [
        { href: '/historia/', label: 'História' },
        { href: '/historia/migalhas/', label: 'Migalhas' },
        { href: '/doutrinas/', label: 'Doutrinas' },
        { href: '/maquinaria/', label: 'Máquina' },
        { href: '/estado/', label: 'Estado' },
      ],
      cta: 'Começar',
    };
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🧅</text></svg>"
    />
    <link rel="preload" href="/fonts/fraunces-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/fraunces-italic-var.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="application/rss+xml" title="Migalhas — o diário vivo do Onion Evolve" href="/historia/migalhas/feed.xml" />
  </head>
  <body>
    <nav>
      <div class="nav-in">
        <a class="brand" href="/">🧅 Onion Evolve <small>{nav.tagline}</small></a>
        <div class="nav-links">
          {nav.links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a class="nav-cta" href="/#comecar">{nav.cta}</a>
        </div>
      </div>
    </nav>
    <slot />
  </body>
</html>
