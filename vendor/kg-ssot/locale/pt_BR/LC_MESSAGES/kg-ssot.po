msgstr "Valor fora da lista permitida em «{field}» {scope}."

#: tools/kg_validate.py
msgid "Violation {code}."
msgstr "Violação {code}."

#: tools/kg_validate.py
msgid "Write the number in quotes, as text, or use a value within ±9007199254740991."
msgstr "Escreva o número entre aspas, como texto, ou use um valor dentro de ±9007199254740991."

#: tools/kg_validate.py
msgid "Write the source of truth (URL, path, command); with no recoverable source, remove provenance and change the status to unverifiable."
msgstr "Escreva a fonte de verdade (URL, caminho, comando); sem fonte recuperável, tire a provenance e mude o status para unverifiable."

#: tools/kg_validate.py
