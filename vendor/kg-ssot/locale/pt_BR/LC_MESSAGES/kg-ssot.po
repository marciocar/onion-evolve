msgstr "raiz do repo: confere a ponta externa das external_edges contra os .kg.yaml e .kg.json sob DIR (sem ela, só a forma e a ponta local)"

#: tools/kg_validate.py
msgid "the MUST schema (default: the current contract)"
msgstr "o MUST (default: o contrato vigente)"

#: tools/kg_validate.py
msgid "the SHOULD schema for warnings (default: the one that goes with --schema)"
msgstr "o SHOULD dos avisos (default: o que acompanha --schema)"

#: tools/kg_validate.py
msgid "the due report on the date (v4.8), instead of the verdict"
msgstr "o relatório de vencimento na data (v4.8), no lugar do veredito"

#: tools/kg_validate.py
msgid "the format of the graph read from '-' (default yaml); a file follows its extension (.json is JSON)"
msgstr "o formato do grafo lido de '-' (default yaml); um arquivo segue a extensão (.json é JSON)"

#: tools/kg_validate.py
msgid "the root is not a map"
msgstr "a raiz não é um mapa"

#: tools/kg_validate.py
msgid "verified on {verified_at}, every {every}, due on {due_on}"
msgstr "verificado em {verified_at}, a cada {every}, venceu em {due_on}"

#: tools/kg_validate.py
msgid "with --format json, occurrences per file (default 50)"
msgstr "no --format json, ocorrências por arquivo (default 50)"

#: tools/kg_validate.py
