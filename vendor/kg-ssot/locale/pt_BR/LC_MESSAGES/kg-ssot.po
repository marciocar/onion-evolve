msgstr "{files} arq  {occurrences} ocorr  +{alone} sozinho  {cls}"

#: tools/kg_validate.py
msgid "· on {as_of}: {due} due, {unstamped} unstamped, {event} by event; the report does not change the verdict"
msgstr "· em {as_of}: {due} vencido(s), {unstamped} sem carimbo, {event} por evento; o relatório não muda o veredito"

#: tools/kg_validate.py
msgid "· {files} files; {passed} pass the MUST; {warned} with a SHOULD warning ({contract})"
msgstr "· {files} arquivos; {passed} passam no MUST; {warned} com aviso SHOULD ({contract})"

#: tools/kg_validate.py
msgid "· {n} file(s) with external_edges: the external end was NOT verified (run with --corpus <repository root>)"
msgstr "· {n} arquivo(s) com external_edges: a ponta externa NÃO foi conferida (rode com --corpus <raiz do repo>)"

#: tools/kg_validate.py
msgid "x_term is the vocabulary profile (v4.11): pref is required; each item of labels needs literal, kind (alt or hidden), and source, and a label with reverify_every needs verified_at."
msgstr "x_term é o perfil de vocabulário (v4.11): pref é obrigatório; cada item de labels precisa de literal, kind (alt ou hidden) e source, e o rótulo com reverify_every precisa de verified_at."

#: tools/kg_validate.py
msgid "x_mirror copies a record of another system (v4.11): system, ref, state, and synced_at are required; resync_every is the cadence that the due report checks."
msgstr "x_mirror copia um registro de outro sistema (v4.11): system, ref, state e synced_at são obrigatórios; resync_every é a cadência que o relatório de vencimento confere."

#: tools/kg_validate.py
msgid "x_doc_cycle is the life cycle of an external document (v4.11): issuer and state are required; state is draft, enacted, in_force, suspended, revoked, expired, or superseded, and recheck_every needs checked_at."
msgstr "x_doc_cycle é o ciclo de vida de um documento externo (v4.11): issuer e state são obrigatórios; state é draft, enacted, in_force, suspended, revoked, expired ou superseded, e recheck_every precisa de checked_at."

#: tools/kg_validate.py
msgid "x_severity is critical, high, medium, low, or info (v4.11)."
msgstr "x_severity é critical, high, medium, low ou info (v4.11)."

#: tools/kg_validate.py
msgid "x_confidence on an edge is a number from 0 to 1 (v4.11)."
msgstr "x_confidence na aresta é um número de 0 a 1 (v4.11)."

#: tools/kg_validate.py
msgid "x_provisional on an edge is true or false (v4.11)."
msgstr "x_provisional na aresta é true ou false (v4.11)."

#: tools/kg_validate.py
msgid "slug is lowercase words joined by hyphens, like my-graph (v4.11)."
msgstr "slug é feito de palavras em minúsculas ligadas por hífen, como meu-grafo (v4.11)."

#: tools/kg_validate.py
msgid "synced on {verified_at}, every {every}, due on {due_on}"
msgstr "sincronizado em {verified_at}, a cada {every}, venceu em {due_on}"

#: tools/kg_validate.py
msgid "checked on {verified_at}, every {every}, due on {due_on}"
msgstr "conferido em {verified_at}, a cada {every}, venceu em {due_on}"

#: tools/kg_validate.py
msgid "cadence {every} without synced_at"
msgstr "cadência {every} sem synced_at"

#: tools/kg_validate.py
msgid "cadence {every} without checked_at"
msgstr "cadência {every} sem checked_at"

#: tools/kg_validate.py
msgid "Cite the id of the node that holds the criterion version (x_criterion); a criterion in another graph is <path>#<id>, which kg_criterion.py check verifies."
msgstr "Cite o id do nó que guarda a versão do critério (x_criterion); um critério de outro grafo é <caminho>#<id>, que o kg_criterion.py check confere."

#: tools/kg_validate.py
msgid "Do not edit a criterion in place: register an amendment (a new node with amends, reason, and SUPERSEDES to the old one) and keep the old result tied to the old sha256."
msgstr "Não edite o critério no lugar: registre uma emenda (um nó novo com amends, reason e SUPERSEDES para o antigo) e deixe o resultado antigo preso ao sha256 antigo."

#: tools/kg_validate.py
msgid "Fields that exclude each other in \"{field}\" {scope}."
msgstr "Campos que se excluem em «{field}» {scope}."

#: tools/kg_validate.py
