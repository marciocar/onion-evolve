msgid "The decision does not say where it came from: it lacks trace, provenance, or a TRACES_TO edge."
msgstr "A decisão não diz de onde veio: falta trace, provenance ou aresta TRACES_TO."

#: tools/kg_validate.py
msgid "The document nests more than 128 collections (maps and lists)."
msgstr "O documento aninha mais de 128 coleções (mapas e listas)."

#: tools/kg_validate.py
msgid "The edge uses the key on, which is forbidden (in YAML 1.1 it becomes the boolean True)."
msgstr "A aresta usa a chave on, proibida (em YAML 1.1 ela vira o booleano True)."

#: tools/kg_validate.py
msgid "The external end points to a file or an id that does not exist in the corpus."
msgstr "A ponta externa aponta para um arquivo ou um id que não existe no corpus."

#: tools/kg_validate.py
msgid "The file has more than one YAML document; it must have exactly one."
msgstr "O arquivo tem mais de um documento YAML; deve ter um só."

#: tools/kg_validate.py
msgid "The file is empty or has only comments."
msgstr "O arquivo está vazio ou só tem comentário."

#: tools/kg_validate.py
msgid "The file is not valid JSON in the .kg.json profile: RFC 8259 syntax (no comments, trailing commas, single quotes, NaN, or Infinity), a BOM only at the start, no lone surrogate, and at most 128 nested collections."
msgstr "O arquivo não é JSON válido no perfil do .kg.json: sintaxe da RFC 8259 (sem comentário, vírgula sobrando, aspas simples, NaN nem Infinity), um BOM só no início, nenhum surrogate solto e até 128 coleções aninhadas."

#: tools/kg_validate.py
msgid "The file is not valid YAML."
msgstr "O arquivo não é YAML válido."

#: tools/kg_validate.py
msgid "The local end of the external edge does not exist in this file."
msgstr "A ponta local da aresta externa não existe neste arquivo."

#: tools/kg_validate.py
msgid "The node has no edge: it stands alone in the graph."
msgstr "O nó não tem nenhuma aresta: está solto no grafo."

#: tools/kg_validate.py
msgid "The node is in PROD, but its only basis is testimony."
msgstr "O nó está em PROD, mas a única base dele é testemunho."

#: tools/kg_validate.py
msgid "The node receives REFUTES and still stands: the graph asserts and refutes the same thing."
msgstr "O nó recebe REFUTES e segue valendo: o grafo afirma e refuta a mesma coisa."

#: tools/kg_validate.py
msgid "The root of the JSON file is not an object (meta, nodes, edges)."
msgstr "A raiz do arquivo JSON não é um objeto (meta, nodes, edges)."

#: tools/kg_validate.py
msgid "The root of the file is not a map (meta, nodes, edges)."
msgstr "A raiz do arquivo não é um mapa (meta, nodes, edges)."

#: tools/kg_validate.py
msgid "The verification date (verified_at) is earlier than the date of the fact (valid_from): either the fact takes effect in the future, or the dates are swapped."
msgstr "A data de verificação (verified_at) é anterior à data do fato (valid_from): ou o fato tem vigência futura, ou as datas estão trocadas."

#: tools/kg_validate.py
msgid "Two nodes have the same id."
msgstr "Dois nós têm o mesmo id."

#: tools/kg_validate.py
msgid "UNSTAMPED"
msgstr "SEM CARIMBO"

#: tools/kg_validate.py
msgid "Use the form '<class>: <detail>', with class measurement, reading, judges, derived, or testimony."
msgstr "Use a forma '<classe>: <detalhe>', com classe measurement, reading, judges, derived ou testimony (ou o alias em português: medição, leitura, juízes, derivado ou testemunho)."

#: tools/kg_validate.py
msgid "Value differs from the required one in \"{field}\" {scope}."
msgstr "Valor diferente do exigido em «{field}» {scope}."

#: tools/kg_validate.py
msgid "Value does not match the expected form in \"{field}\" {scope}."
msgstr "Valor fora da forma esperada em «{field}» {scope}."

#: tools/kg_validate.py
