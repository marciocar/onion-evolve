{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kg-ssot:spec:rituals.schema.json",
  "title": "Relatório do ritmo (kg-ssot.rituals/1)",
  "description": "Saída de `kg_validate.py --rituals QUANDO --format json`. Não é veredito: lista, por dono, cada ritual (o nó com x_ritual, perfil do contrato v4.25) num estado: failing (a execução mais recente que falhou, x_outcome ou kgssotoutcome fail ou error, não tem uma que passou depois), never_run (nenhuma execução vista: sem verified_at, sem evidence com TRACES_TO e sem evento no registro), late (passou do prazo pelo calendário, quando ele se expande, uma ocorrência da RRULE depois da última execução que passou, ou do dtstart quando nenhuma passou, e antes de as_of menos a folga; sem o calendário expandido, pela cadência, o verified_at mais o reverify_every antes do dia de hoje), event_only (só reverify_on) ou on_time. late_by diz por onde está atrasado, inclusive no failing e no never_run, e é o que o kg_gate.py --rituals-overdue conta. notes traz calendar-ended quando o COUNT ou o UNTIL chegou. As datas e os instantes saem no fuso do ritual; last_pass e last_run são a data AAAA-MM-DD quando a fonte é o verified_at, que tem precisão de dia. O calendar só existe no ritual com x_ritual.calendar, e expanded é false sem o extra python-dateutil (expander null), com a forma do calendário fora do SHOULD ou com o fuso que a máquina não conhece (notes diz qual). runs é null sem --runs; com ele, conta os eventos lidos e lista os ignorados com o motivo. tzdata é a versão da base tz da máquina, quando se lê.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "as_of",
    "expander",
    "tzdata",
    "grace",
    "runs",
    "owners",
    "broken"
  ],
  "properties": {
    "schema_version": {
      "const": "kg-ssot.rituals/1"
    },
    "as_of": {
      "type": "string"
    },
    "expander": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "const": "python-dateutil"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "tzdata": {
      "type": [
        "string",
        "null"
      ]
    },
    "grace": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^PT(?:[0-9]+H)?(?:[0-9]+M)?(?:[0-9]+S)?$"
    },
    "runs": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "files",
        "events",
        "ignored"
      ],
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "events": {
          "type": "integer",
          "minimum": 0
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file",
              "reason"
            ],
            "properties": {
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "event": {
                "type": "integer",
                "minimum": 1
              },
              "reason": {
                "enum": [
                  "not-json",
                  "not-cloudevents",
                  "missing-type-subject-or-time",
                  "unknown-outcome"
                ]
              }
            }
          }
        }
      }
    },
    "owners": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owner",
          "rituals"
        ],
        "properties": {
          "owner": {
            "type": [
              "string",
              "null"
            ]
          },
          "rituals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "file",
                "id",
                "owner",
                "state",
                "late_by",
                "last_run",
                "last_pass",
                "last_failure",
                "last_failure_ref",
                "reverify_every",
                "reverify_on",
                "due_on",
                "days_late",
                "calendar",
                "notes"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "owner": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "state": {
                  "enum": [
                    "failing",
                    "never_run",
                    "late",
                    "event_only",
                    "on_time"
                  ]
                },
                "late_by": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "cadence",
                      "calendar"
                    ]
                  },
                  "uniqueItems": true
                },
                "last_run": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_pass": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_failure": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "last_failure_ref": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reverify_every": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "reverify_on": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "due_on": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "days_late": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "calendar": {
                  "type": [
                    "object",
                    "null"
                  ],
                  "additionalProperties": false,
                  "required": [
                    "expanded",
                    "late_since",
                    "missed",
                    "next_run"
                  ],
                  "properties": {
                    "expanded": {
                      "type": "boolean"
                    },
                    "late_since": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "missed": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "next_run": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                "notes": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "tz-unknown",
                      "calendar-malformed",
                      "calendar-not-expanded",
                      "evidence-without-time",
                      "calendar-ended"
                    ]
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    },
    "broken": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "error"
        ],
        "properties": {
          "file": {
            "type": "string"
          },
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
