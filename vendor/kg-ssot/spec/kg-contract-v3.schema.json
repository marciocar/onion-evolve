{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onion-kg-ssot/spec/kg-contract-v3.schema.json",
  "title": "kg.yaml — contrato v3, nível MUST",
  "description": "O contrato v3 do .kg.yaml, nível MUST (reprova). Escrito à mão em JSON Schema 2020-12 (Q_CONTRACT_SOURCE_OF_TRUTH). Parte da gramática documentada (kg-strict.schema.json, a régua do spike) e aplica as decisões seladas: chave desconhecida não reprova aqui, só alerta no nível SHOULD (Q_CONTRACT_EXTENSION_POLICY); chaves recorrentes promovidas; prefixo x_ livre; PROD sem verified_at é SHOULD e o gatilho de TRANSITIONS é trigger (Q_CONTRACT_CONFORMANCE_LEVELS). O par SHOULD é kg-contract-v3.should.schema.json; as regras de perfil YAML (chave on proibida, chave duplicada, documento único) são do leitor, porque o JSON não as vê. No v2 (Q_CONTRACT_FACT_NARRATIVE e Q_CONTRACT_YAML_JSON_GAP): o nó ganha narrative (texto livre) e o meta conhece note e purpose; data completa tem de existir no calendário (format: date, e o leitor checa também valid_from); valor que o JSON não representa (.nan, .inf) reprova como tipo. format: date é ASSERÇÃO, não anotação: todo leitor tem de checar o calendário (RFC 3339 full-date). No v3 (Q_CONTRACT_STRUCTURED_PROVENANCE): o nó pode ter provenance, um objeto com source (o que foi consultado), locator (onde dentro dele) e method (como); quando presente, os três são obrigatórios e não vazios. provenance: null reprova (o objeto, quando presente, precisa dos três campos); a ausência só alerta, no SHOULD.",
  "type": "object",
  "required": [
    "meta",
    "nodes",
    "edges"
  ],
  "properties": {
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "format": "date"
    },
    "partialDate": {
      "type": "string",
      "pattern": "^(000[1-9]|00[1-9][0-9]|0[1-9][0-9]{2}|[1-9][0-9]{3})(-(0[1-9]|1[0-2])(-[0-9]{2})?)?$",
      "if": {
        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
      },
      "then": {
        "format": "date"
      }
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "layer": {
      "enum": [
        "audit",
        "domain"
      ]
    },
    "meta": {
      "type": "object",
      "required": [
        "schema_version",
        "id"
      ],
      "properties": {
        "schema_version": {
          "const": "1"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "$ref": "#/$defs/date"
        },
        "date": {
          "$ref": "#/$defs/date"
        },
        "review_after": {
          "$ref": "#/$defs/date"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "note": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "node_type",
        "plane",
        "status",
        "impact",
        "confidence",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "node_type": {
          "enum": [
            "entity",
            "claim",
            "decision",
            "question",
            "evidence",
            "artifact",
            "state",
            "event",
            "rule",
            "invariant",
            "policy"
          ]
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "plane": {
          "enum": [
            "DEV",
            "PROD"
          ]
        },
        "status": {
          "enum": [
            "open",
            "confirmed",
            "drifted",
            "unverifiable",
            "refuted",
            "superseded",
            "done"
          ]
        },
        "impact": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "trace": {
          "type": "string"
        },
        "verified_at": {
          "$ref": "#/$defs/date"
        },
        "verified_against": {
          "type": "string"
        },
        "valid_from": {
          "$ref": "#/$defs/partialDate"
        },
        "source_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "source_kind": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "drive_kind": {
          "type": "string"
        },
        "evidence_class": {
          "type": "string"
        },
        "sealed_by": {
          "type": "string"
        },
        "sealed_at": {
          "type": "string"
        },
        "narrative": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "from",
        "to",
        "edge_type"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "edge_type": {
          "enum": [
            "SUPPORTS",
            "REFUTES",
            "SUPERSEDES",
            "CAUSES",
            "DEPENDS_ON",
            "TRACES_TO",
            "CONSTRAINS",
            "HAS_STATE",
            "TRANSITIONS",
            "EMITS",
            "READS",
            "WRITES"
          ]
        },
        "label": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/nodeId"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "locator",
        "method"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
