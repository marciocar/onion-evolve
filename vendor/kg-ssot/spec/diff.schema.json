{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kg-ssot:spec:diff.schema.json",
  "title": "Diff por id entre revisões de grafos (kg-ssot.diff/1)",
  "description": "Saída de `kg_diff.py --format json`. Os nós são alinhados pelo id e as arestas pelas pontas e o tipo (from, to, edge_type): o que só existe de um lado foi acrescentado ou removido, e o que existe nos dois sai em `changed` com cada campo que mudou, em caminho pontuado (`provenance.source`), antes e depois; o campo ausente de um lado vale null. Uma lista é comparada inteira. A aresta que troca de tipo com as mesmas pontas sai em `changed` com o campo edge_type, não como remoção e acréscimo. O meta e as outras chaves da raiz (o contrato não fecha a raiz) saem em `meta`, com o caminho a partir da raiz: `meta.title`, `meta` quando ele não é mapa, `x_algo`. Os valores comparam pelo tipo também (1, 1.0 e true diferem), e o id repetido conta cada ocorrência, na ordem. A ordem dos nós no arquivo não conta, e uma troca de id é remoção mais acréscimo. Não é patch: o diff informa, não se aplica. `status` é modified, added, removed, unchanged ou unreadable; no unreadable, `unreadable` traz o código parse.* de cada lado que não parseou e `diff` é null. Desde a 4.17.1, o campo que sai de um caminho e entra noutro com o mesmo valor (num nó, numa aresta ou no meta), não trivial e único dos dois lados, é marcado como renomeação: as duas entradas ficam, cada uma com o valor do seu caminho (o lado ausente segue null), a que sai com renamed_to e a que entra com renamed_from; o texto humano e o summary.fields mostram uma linha só. O --from sem caminhos deixa de fora o vendor e os fixtures.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "before",
    "after",
    "ignored",
    "summary",
    "graphs"
  ],
  "properties": {
    "schema_version": {
      "const": "kg-ssot.diff/1"
    },
    "before": {
      "type": "string",
      "description": "o que foi pedido como antes: arquivo, REV:CAMINHO ou a revisão"
    },
    "after": {
      "type": "string"
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "os campos que o --ignore tirou da comparação (o caminho e o que fica abaixo dele); no meta, com o prefixo meta."
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modified",
        "added",
        "removed",
        "unchanged",
        "unreadable",
        "nodes_added",
        "nodes_removed",
        "nodes_changed",
        "edges_added",
        "edges_removed",
        "edges_changed",
        "fields"
      ],
      "properties": {
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "unreadable": {
          "type": "integer",
          "minimum": 0
        },
        "nodes_added": {
          "type": "integer",
          "minimum": 0
        },
        "nodes_removed": {
          "type": "integer",
          "minimum": 0
        },
        "nodes_changed": {
          "type": "integer",
          "minimum": 0
        },
        "edges_added": {
          "type": "integer",
          "minimum": 0,
          "description": "arestas e arestas externas"
        },
        "edges_removed": {
          "type": "integer",
          "minimum": 0
        },
        "edges_changed": {
          "type": "integer",
          "minimum": 0
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          },
          "description": "quantos nós mudaram cada campo, do mais frequente ao menos: separa o sinal do ruído de regeneração"
        }
      }
    },
    "graphs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "before",
        "after"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "before": true,
        "after": true,
        "renamed_from": {
          "type": "string",
          "description": "desde a 4.17.1: no campo que entrou (before null), o caminho de onde o mesmo valor saiu"
        },
        "renamed_to": {
          "type": "string",
          "description": "desde a 4.17.1: no campo que saiu (after null), o caminho onde o mesmo valor entrou"
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "node_type",
        "status",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "node_type": true,
        "status": true,
        "label": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "edge_type"
      ],
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ],
          "description": "null na aresta externa que parte do grafo inteiro"
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        },
        "edge_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": true,
        "trigger": true,
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "properties": {
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "changed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edge"
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "before",
        "after",
        "status",
        "diff"
      ],
      "properties": {
        "before": {
          "type": [
            "string",
            "null"
          ],
          "description": "o caminho de antes, ou null no grafo acrescentado"
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "description": "o caminho de depois, ou null no grafo removido"
        },
        "status": {
          "enum": [
            "modified",
            "added",
            "removed",
            "unchanged",
            "unreadable"
          ]
        },
        "unreadable": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "before": {
              "type": "string"
            },
            "after": {
              "type": "string"
            }
          }
        },
        "diff": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "meta",
                "nodes",
                "edges",
                "external_edges"
              ],
              "properties": {
                "meta": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/field"
                  }
                },
                "nodes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "added",
                    "removed",
                    "changed"
                  ],
                  "properties": {
                    "added": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/node"
                      }
                    },
                    "removed": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/node"
                      }
                    },
                    "changed": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "label",
                          "fields"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "fields": {
                            "type": "array",
                            "items": {
                              "$ref": "#/$defs/field"
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "edges": {
                  "$ref": "#/$defs/edges"
                },
                "external_edges": {
                  "$ref": "#/$defs/edges"
                }
              }
            }
          ]
        }
      }
    }
  }
}
