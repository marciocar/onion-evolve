{
  "manifest_version": "0.4",
  "name": "kg-ssot",
  "display_name": "KG-SSOT — verifiable knowledge graphs",
  "version": "@VERSION@",
  "description": "Validates and stores .kg.yaml and .kg.json knowledge graphs under the KG-SSOT contract: every claim says where it came from and when it was last verified.",
  "long_description": "The reference KG-SSOT MCP server gives a model the formal contract of the verifiable knowledge graph and a store that only writes what passes it.\n\n- **kg_validate** checks a .kg.yaml or .kg.json text and returns the structured verdict, with code, path, line, message and fix hint.\n- **kg_write** writes to the store only what passes the contract; **kg_get**, **kg_list**, **kg_query**, **kg_terms**, **kg_history** and **kg_delete** complete the store; **kg_query** queries the graphs with every edge resolved to its label. **kg_terms** resolves a domain term by a synonym, with the source and the verification date of each synonym.\n- **kg_schema_help** returns the current contract, a minimal example and the most common fixes.\n\nThe store lives in the folder you choose, on your computer. The server runs locally over stdio and talks to no external service. Read-only tools are annotated as such. Manual: https://github.com/marciocar/kg-ssot/tree/main/docs/manual · Em português: https://github.com/marciocar/kg-ssot/blob/main/README.pt-BR.md",
  "author": {
    "name": "Marcio Carvalho"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/marciocar/kg-ssot"
  },
  "homepage": "https://github.com/marciocar/kg-ssot",
  "documentation": "https://github.com/marciocar/kg-ssot/tree/main/docs/manual",
  "support": "https://github.com/marciocar/kg-ssot/issues",
  "icon": "icon.png",
  "localization": {
    "resources": "mcpb-resources/${locale}.json",
    "default_locale": "en-US"
  },
  "server": {
    "type": "uv",
    "entry_point": "server/main.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "server/main.py",
        "--root",
        "${user_config.root}",
        "--read-only",
        "${user_config.read_only}"
      ]
    }
  },
  "tools": [
    {
      "name": "kg_validate",
      "description": "Checks a .kg.yaml or .kg.json graph against the contract and returns the structured verdict."
    },
    {
      "name": "kg_write",
      "description": "Writes a graph to the store, only if it passes the contract."
    },
    {
      "name": "kg_get",
      "description": "Reads a graph from the store."
    },
    {
      "name": "kg_list",
      "description": "Lists the graphs in the store."
    },
    {
      "name": "kg_query",
      "description": "Queries the graphs in the store: filters, the open queue and neighborhoods, with every edge resolved to its label."
    },
    {
      "name": "kg_terms",
      "description": "Resolves a domain term by its preferred name or a synonym, with the source and the date each synonym was verified."
    },
    {
      "name": "kg_history",
      "description": "Shows the write history of a graph."
    },
    {
      "name": "kg_delete",
      "description": "Removes a graph, only if no other graph stops passing because of it."
    },
    {
      "name": "kg_schema_help",
      "description": "Returns the current contract, a minimal example and the most common fixes."
    }
  ],
  "keywords": [
    "knowledge-graph",
    "provenance",
    "verifiable",
    "json-schema",
    "yaml",
    "audit",
    "mcp",
    "kg-ssot"
  ],
  "license": "Apache-2.0",
  "compatibility": {
    "platforms": [
      "darwin",
      "linux",
      "win32"
    ],
    "runtimes": {
      "python": ">=3.11"
    }
  },
  "user_config": {
    "root": {
      "type": "directory",
      "title": "Store folder",
      "description": "Where the graphs are written. If the folder cannot be opened, the server only validates and Claude says why; inside a git repository, every write becomes a commit.",
      "required": true,
      "default": "${DOCUMENTS}/kg-ssot"
    },
    "read_only": {
      "type": "boolean",
      "title": "Read only",
      "description": "No kg_write or kg_delete: the model only validates and reads.",
      "required": false,
      "default": false
    }
  }
}
