+// src/a2a-invites.ts — SPIKE F0 do configurador A2A (SAC-121; testes S4=SAC-129, S5=SAC-130).
+// NÃO É PRODUÇÃO. Duas peças:
+//   1. CONVITE POR MEMBRO: arquivo JSON (A2A_INVITES_FILE) com [{token_sha256, member, receiver,
+//      expires_at, revoked}], RELIDO a cada POST (revogar = editar o arquivo, sem restart). O arquivo
+//      guarda só o sha256 do bearer — vazar o arquivo não vaza credencial.
+//   2. RECEPTOR MÚLTIPLO: o receptor vem da rota (/a2a/:receiver); só é aceito se, no members.yaml do
+//      core (ONION_CWD), tiver role: source ou role: hub.
+// Fail-closed nas duas: arquivo ilegível/forma errada ⇒ nenhum convite vale; members.yaml ilegível ⇒
+// nenhum receptor vale. Ausência nunca é aprovação.
+import { readFileSync, existsSync } from "node:fs";
+import { createHash, timingSafeEqual } from "node:crypto";
+import { spawn } from "node:child_process";
+import { join } from "node:path";
+import { config } from "./config.ts";
+
+export type Invite = {
+  token_sha256: string;
+  member: string;
+  receiver: string;
+  expires_at: string; // ISO-8601
+  revoked: boolean;
+};
+
+export type InviteMatch =
+  | { status: "ok"; invite: Invite }
+  | { status: "expired" | "revoked" | "unknown" | "no-file" };
+
+const ID_RE = /^[A-Za-z0-9._-]{1,128}$/;
+export const DEFAULT_RECEIVER = "onion-evolve";
+
+export function isSafeId(s: unknown): s is string {
+  return typeof s === "string" && ID_RE.test(s) && !s.startsWith("-") && s !== "." && s !== "..";
+}
+
+function wellFormed(x: any): x is Invite {
+  return (
+    x &&
+    typeof x.token_sha256 === "string" &&
+    /^[0-9a-f]{64}$/.test(x.token_sha256) &&
+    isSafeId(x.member) &&
+    isSafeId(x.receiver) &&
+    typeof x.expires_at === "string" &&
+    !Number.isNaN(Date.parse(x.expires_at)) &&
+    typeof x.revoked === "boolean"
+  );
+}
+
+// Relido A CADA chamada (o requisito do S4: revogar sem restart). Custo: um readFileSync de
+// poucos KB por POST — irrelevante perto do spawn do gate (~centenas de ms).
+function loadInvites(): Invite[] | null {
+  const f = config.a2aInvitesFile;
+  if (!f || !existsSync(f)) return null;
+  try {
+    const raw = JSON.parse(readFileSync(f, "utf8"));
+    const list = Array.isArray(raw) ? raw : raw?.invites;
+    if (!Array.isArray(list)) return [];
+    // linha malformada é IGNORADA (não derruba as outras) — e nunca vale como convite
+    return list.filter(wellFormed);
+  } catch {
+    return []; // JSON quebrado no meio de uma edição ⇒ fail-closed (ninguém entra), não fail-open
+  }
+}
+
+export function matchInvite(bearer: string, now = Date.now()): InviteMatch {
+  const invites = loadInvites();
+  if (invites === null) return { status: "no-file" };
+  const h = Buffer.from(createHash("sha256").update(bearer, "utf8").digest("hex"), "utf8");
+  // varre TODOS (sem early-return) para o tempo não revelar a posição do convite
+  let hit: Invite | undefined;
+  for (const inv of invites) {
+    const b = Buffer.from(inv.token_sha256, "utf8");
+    if (b.length === h.length && timingSafeEqual(b, h) && !hit) hit = inv;
+  }
+  if (!hit) return { status: "unknown" };
+  if (hit.revoked) return { status: "revoked" };
+  if (Date.parse(hit.expires_at) <= now) return { status: "expired" };
+  return { status: "ok", invite: hit };
+}
+
+// role do receptor no members.yaml do core. Lê com python3+yaml — o MESMO parser que o a2a-verify usa
+// para kid/mode (o trust-topology-check usa awk: são dois parsers do mesmo arquivo — risco anotado).
+export function receiverRole(receiver: string): Promise<string | null> {
+  const members = join(config.onionCwd, "docs/evolution/federation/members.yaml");
+  const py = [
+    "import sys, yaml",
+    "try: ms=(yaml.safe_load(open(sys.argv[1])) or {}).get('members') or []",
+    "except Exception: sys.exit(3)",
+    "for m in ms:",
+    "    if isinstance(m, dict) and m.get('id')==sys.argv[2]: print(m.get('role','') or ''); sys.exit(0)",
+    "sys.exit(4)",
+  ].join("\n");
+  return new Promise((resolve) => {
+    let out = "";
+    let done = false;
+    const fin = (v: string | null) => { if (!done) { done = true; clearTimeout(t); resolve(v); } };
+    const child = spawn("python3", ["-I", "-c", py, members, receiver], { stdio: ["ignore", "pipe", "ignore"] });
+    const t = setTimeout(() => { child.kill("SIGKILL"); fin(null); }, 5_000);
+    child.stdout.setEncoding("utf8");
+    child.stdout.on("data", (d: string) => (out += d));
+    child.on("error", () => fin(null));
+    child.on("close", (code) => fin(code === 0 ? out.trim() : null));
+  });
+}
+
+export const RECEIVER_ROLES = new Set(["source", "hub"]);
