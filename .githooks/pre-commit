#!/usr/bin/env bash
# =============================================================================
# Onion — pre-commit hook
# -----------------------------------------------------------------------------
# Roda o MESMO linter determinístico do CI (.github/workflows/onion-validate.yml)
# localmente, antes do commit. Falha (exit 1) se houver violação HARD — fail-fast
# que evita descobrir o drift só no CI. Violações SOFT não bloqueiam.
#
# Cobre as guardas de SSOT (inventário vs filesystem, contagens em CLAUDE.md e
# docs/onion/) — ver .claude/validation/lint-artifacts.sh.
#
# Ativação (opt-in, uma vez por clone):
#     git config core.hooksPath .githooks
#
# Desativar temporariamente um commit: git commit --no-verify
# =============================================================================
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# ── GUARDA ANTI-COMMIT-NA-DEFAULT-BRANCH (cura de recorrência: 2026-08-23, 2 slips numa sessão) ──
# O fluxo Onion é feature-branch → PR → merge (CI + passada adversarial REGRA 56). Commit LOCAL
# direto na default branch PULA os dois — foi assim que o escopo abrangente do backlog foi para main
# sem revisão. Bloqueia; a cura é branchar. Escape consciente (merge/hotfix) = --no-verify.
# CORE-ONLY: vive no hook PRÓPRIO do core (difere do template vendorizado) — não viaja ao adotante,
# que pode ter fluxo trunk-based (a lição "o core é o pior oráculo do que viaja").
_ONION_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '')"
_ONION_DEFAULT="$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@')"
[ -n "${_ONION_DEFAULT}" ] || _ONION_DEFAULT=main
if [ "${_ONION_BRANCH}" = "${_ONION_DEFAULT}" ]; then
  echo "🛑 Onion pre-commit — commit DIRETO na default branch (${_ONION_DEFAULT}) BLOQUEADO." >&2
  echo "   O fluxo é feature-branch → PR → merge (CI + REGRA 56). Commit em ${_ONION_DEFAULT} pula os dois." >&2
  echo "   Cure: git branch <nome-em-ingles> && git switch <nome>   (o commit staged vai junto)" >&2
  echo "   Escape consciente (merge/hotfix): git commit --no-verify" >&2
  exit 1
fi
# ── VARREDURA DE FIXTURES ÓRFÃS — ANTES do lint, e a ordem é o ponto ─────────────────────────
# A bancada cria fixtures NA ÁRVORE VIVA (deliberado: ela exercita guardas que só existem num repo
# de verdade). Rodada INTERROMPIDA as deixa para trás, e o lint seguinte as lê como artefatos REAIS:
# medido 3x em 2026-09-15, uma delas com 271 HARD — todas fixtures, nenhuma do código.
# As três vezes a cura foi eu LEMBRAR de limpar, e cura-que-depende-de-lembrar não é cura.
# O helper é conservador por construção (só untracked/ignorado, nome derivado da própria bancada,
# `__fixtures__` e `node_modules/` fora) e NUNCA silencioso — ver o docstring dele.
_SWEEP="${REPO_ROOT}/.claude/validation/sweep-orphan-fixtures.sh"
[ -f "${_SWEEP}" ] && bash "${_SWEEP}" || true

LINT="${REPO_ROOT}/.claude/validation/lint-artifacts.sh"

# Sem o linter no repo (ex.: projeto-alvo sem .claude/validation) → não bloqueia.
[ -f "${LINT}" ] || exit 0

# ── (APOSENTADO na F4 das portas, 2026-10-10, SAC-93) AUTO-REGENERAÇÃO DE PLUGINS ─────────────────
# Aqui morava o auto-fix da REGRA 19 (Plugins de vertical sincronizados com as fontes): fonte bundlada no commit ⇒ remontar plugins/<vertical> e o
# marketplace.json e stagear. Era a cura MECÂNICA de um atrito que a F4 tirou pela raiz: o `plugins/`
# versionado saiu do core (o bundle é montado na publicação, /meta:publish onion-plugins, e julgado lá
# pelo plugin-bundle-check.sh). Um PR que toca uma fonte bundlada não regenera mais nada. O catálogo da
# raiz (REGRA 76 (marketplace.json da raiz aponta o repo PÚBLICO e é projeção dos manifestos)) depende só dos MANIFESTOS e entrou na tabela de projeções abaixo.

# ── PROJEÇÃO GERADA REGENERADA JUNTO, POR TABELA (REGRAS 8/16, 39, 62, 80, 81, 84) ───────────
# POR QUE EXISTE, e a história é de reincidência medida: a primeira versão deste bloco cobria UMA
# projeção (o painel da REGRA 81) porque ela me barrou TRÊS vezes num dia. Em 2026-10-01 a MESMA
# classe me barrou QUATRO vezes com projeções DIFERENTES — `lint-rules.md` (R39, editado à mão num
# PR cujo tema era "o número sai da medição, nunca da prosa"), `inventory.md` (R16, contagem
# propagada por UMA redação quando o lint conhece três), `testing-inventory.md` (R80) e as
# projeções de KG (R62/R84, regeneradas ANTES de estagiar e por isso nascidas obsoletas).
#
# O maestro nomeou o ponto: se a lição se repete, o problema é de MECANISMO. Então o bloco deixa de
# ser um caso e vira TABELA — cada linha é (gatilho staged · gerador · alvo · regra), e cobrir uma
# projeção nova passa a ser acrescentar uma linha, não escrever outro bloco. A cura de disciplina
# ("lembrar de regenerar") é cura nula nesta casa; esta é a estrutural.
#
# ⚠️ ORDEM: este bloco roda ANTES do re-carimbo da REGRA 56 logo abaixo, e o caso (b) da família
# `hook_chain_order` COBRA isso — auto-fix depois do carimbo torna o hash caduco, que foi o defeito
# ARTEFATO-CADUCO medido 2x em 2026-10-01.
#
# ⚠️ TETO: auto-fix COM RASTRO no commit, e toda regra segue HARD no CI — quem contorna o hook
# (`--no-verify`, que aqui é checkpoint e não validação) ainda é pego lá.
# O MOTOR vive em lib (sourçada), não aqui: a guarda de âncora morta cobra que símbolo citado por
# âncora de `sed` exista em `.claude/validation/*.sh`, e a bancada passa a sourçar o artefato REAL.
_REGEN_LIB="${REPO_ROOT}/.claude/validation/onion-regen-lib.sh"
if [ -r "${_REGEN_LIB}" ]; then
  # shellcheck source=/dev/null
  . "${_REGEN_LIB}"
else
  echo "⚠️  onion-regen-lib.sh AUSENTE — projeções NÃO serão regeneradas; as REGRAS 8/21/24/31/38/39/62/80/81/84 vão acusar."
  onion_regen() { :; }; onion_staged() { :; }
fi

_V="${REPO_ROOT}/.claude/validation"
# O painel lê review-ledger (CONTA resíduos) E harness-inventory (CONTA famílias): os dois gatilhos.
[ -n "$(onion_staged 'docs/evolution/review/*.md' '.claude/validation/lint-selftest.sh')" ]   && [ -f "${_V}/testing-state.sh" ]   && onion_regen docs/onion/testing-state.md 81 bash "${_V}/testing-state.sh" --markdown
# A tabela de doutrina é PROJEÇÃO do registro, que deriva dos docstrings do lint.
[ -n "$(onion_staged '.claude/validation/rules-registry.sh' '.claude/validation/lint-artifacts.sh')" ]   && [ -f "${_V}/rules-registry.sh" ]   && onion_regen .claude/validation/lint-rules.md 39 bash "${_V}/rules-registry.sh"
# ⚠️ GATILHO AMPLIADO em 2026-10-02: o harness-inventory CONTA FIXTURES tambem, e a 1a versao da
# tabela gatilhava so em lint-selftest.sh — mexer em fixture defasava o inventario SEM disparar a
# regeneracao, e a REGRA 80 barrou o commit. Lacuna de VOCABULARIO do gatilho, nao da logica: a
# classe que mais falha em guarda de lista, aplicada a propria tabela que cura a classe.
[ -n "$(onion_staged '.claude/validation/lint-selftest.sh' '.claude/validation/fixtures')" ] \
  && [ -f "${_V}/harness-inventory.sh" ] \
  && onion_regen docs/onion/testing-inventory.md 80 bash "${_V}/harness-inventory.sh" --markdown
# O console da federacao e projecao do members.yaml (REGRA 24) — registrar um adotante defasava o
# console e barrava o commit seguinte. Mesma lacuna, descoberta na mesma passada.
[ -n "$(onion_staged 'docs/evolution/federation/members.yaml')" ] \
  && [ -f "${_V}/federation-console.sh" ] \
  && onion_regen docs/onion/federation-console.html 24 bash "${_V}/federation-console.sh"
[ -n "$(onion_staged '.claude/commands' '.claude/agents' '.claude/skills' 'docs/knowledge-base')" ]   && [ -f "${_V}/inventory.sh" ]   && onion_regen docs/onion/inventory.md 8 bash "${_V}/inventory.sh" --markdown
# O catálogo da RAIZ (REGRA 76 (marketplace.json da raiz aponta o repo PÚBLICO e é projeção dos manifestos)) é projeção dos MANIFESTOS desde a F4 das portas (2026-10-10): só muda
# quando muda um manifesto (nome/descrição/keywords), o gerador ou a face pública — nunca por uma fonte
# bundlada. O gerador lê o topo do arquivo existente, por isso ele escreve em temp e o alvo é trocado
# pelo onion_regen (redirecionar direto truncaria o topo antes da leitura).
[ -n "$(onion_staged '.claude/utils/marketplace/verticals' '.claude/utils/marketplace/generate-marketplace.sh' '.claude/utils/marketplace/public-face.sh')" ] \
  && [ -f "${REPO_ROOT}/.claude/utils/marketplace/generate-marketplace.sh" ] && [ -f "${REPO_ROOT}/.claude-plugin/marketplace.json" ] \
  && onion_regen .claude-plugin/marketplace.json 76 bash "${REPO_ROOT}/.claude/utils/marketplace/generate-marketplace.sh" "${REPO_ROOT}" --from-manifests
# O MAPA e o GRAFO fecham a tabela, e as duas lacunas foram descobertas pelo gate neste mesmo PR:
# · REGRA 38 (mapa da federação) deriva do members.yaml — registrar um adotante deixava o mapa
#   defasado e o commit barrado, com a correção óbvia e manual.
# · REGRA 21 (grafo) deriva, entre outras fontes, do capability contract dos plugins. Até a F4 das
#   portas ele vinha de plugins/*/capability.json (que o auto-fix regenerava); desde 2026-10-10 vem dos
#   MANIFESTOS, então o gatilho é o diretório deles além das fontes de spec-as-code.
[ -n "$(onion_staged 'docs/evolution/federation/members.yaml')" ] \
  && [ -f "${_V}/graph.sh" ] \
  && onion_regen docs/onion/federation-map.md 38 bash "${_V}/graph.sh" --map
[ -n "$(onion_staged '.claude/utils/marketplace/verticals' '.claude/commands' '.claude/agents' '.claude/skills' 'docs/evolution/federation/members.yaml')" ] \
  && [ -f "${_V}/graph.sh" ] \
  && onion_regen docs/onion/graph.md 21 bash "${_V}/graph.sh" --markdown
if [ -n "$(onion_staged '*.kg.yaml')" ]; then
  [ -f "${_V}/kg-trace-resolve.sh" ]     && onion_regen docs/onion/kg-read-index.tsv 84 bash "${_V}/kg-trace-resolve.sh" . --emit-index
  # o projetor de backlog custa ~14s por invocação (medido) — por isso só com .kg.yaml staged
  [ -f "${_V}/kg-backlog-project.sh" ]     && onion_regen docs/backlog.md 62 bash "${_V}/kg-backlog-project.sh" --markdown
  # A LENTE (REGRA 31) estava fora, e o Elenxo a PROVOU: bastou tocar um `.kg.yaml` com lente para
  # a HARD aparecer. O bloco de `*.kg.yaml` regenerava o índice e o backlog e não a lente — a classe
  # exata que esta tabela existe para fechar, dentro do próprio bloco que a fecha para os irmãos.
  if [ -f "${_V}/kg-view.sh" ]; then
    for _lens in $(git ls-files 'docs/onion/graph/*-radar.md' 'docs/**/*-radar.md' 2>/dev/null); do
      _lens_kg="${_lens%-radar.md}.kg.yaml"
      [ -f "${REPO_ROOT}/${_lens_kg}" ] || continue
      onion_regen "${_lens}" 31 bash "${_V}/kg-view.sh" "${_lens_kg}" --markdown
    done
  fi
fi

# ── E O HASH DA REGRA 56 RE-CARIMBADO, senao a cura acima cria outro defeito ─────────────────
# O autor carimba o `reviewed_diff_sha256` ANTES do commit; o auto-fix do painel acrescenta arquivo
# DEPOIS — o diff muda e o hash fica caduco. Medido no PRIMEIRO uso real (PR #860): o CI acusou
# ARTEFATO-CADUCO num commit cujo unico "culpado" era o proprio hook que eu acabara de escrever.
#
# ⚠️ A CONDICAO E "HA RESIDUO STAGED", nao "o painel mudou". Na 1a tentativa pus isto dentro do ramo
#    do `cmp`, e ele nao rodava justamente no caso que importa: painel ja atualizado por um commit
#    ANTERIOR, cujo hash ficou caduco la. Condicao errada = guarda que existe e nao alcanca.
#
# A formula e a MESMA de review-artifact-check.sh (flags canonicos + exclusao de
# `docs/evolution/review/`), senao hook e gate discordariam sobre o mesmo numero. Converge porque o
# hash exclui o diretorio de review: re-adicionar o residuo nao altera o valor.
# ⚠️ A ATRIBUIÇÃO FOI RESTAURADA em 2026-10-02, achado de Elenxo: ela havia sido apagada no commit
# anterior e o consumidor virou `${_RES_STAGED:-}` — o `:-` calou o `set -u`, que era o ÚNICO
# mecanismo capaz de gritar. Resultado: este bloco inteiro NUNCA executava, e o defeito
# ARTEFATO-CADUCO que ele cura ficou descoberto. É a classe `exit-code-nao-e-a-verificacao`: o gate
# saía verde porque não havia como ele saber. Nunca silencie `set -u` num consumidor sem conferir
# que a atribuição existe — `:-` transforma variável-que-sumiu em string vazia plausível.
# E a atribuição usa `onion_staged`, não um pipe próprio: a 1ª tentativa de restaurá-la reescreveu
# `git diff … 2>/dev/null | head -1`, que é o fechador-precoce-sob-pipefail + erro-engolido que este
# mesmo PR cura no `.tpl`. O helper já lê o rc e não tem pipe.
_RES_STAGED="$(onion_staged 'docs/evolution/review/*.md')"
if [ -n "${_RES_STAGED}" ]; then
  _r56_base="$(git merge-base origin/main HEAD 2>/dev/null || true)"
  if [ -n "${_r56_base}" ]; then
    _r56_sha="$(git -c core.abbrev=40 -c diff.noprefix=false diff --no-ext-diff --no-color \
      --cached "${_r56_base}" -- . ':(exclude)docs/evolution/review' 2>/dev/null | sha256sum | cut -c1-64)"
    for _r56_f in $(git diff --cached --name-only --diff-filter=ACMR -- 'docs/evolution/review/*.md' 2>/dev/null); do
      [ -f "${REPO_ROOT}/${_r56_f}" ] || continue
      LC_ALL=C grep -q '^reviewed_diff_sha256:' "${REPO_ROOT}/${_r56_f}" || continue
      LC_ALL=C grep -q "^reviewed_diff_sha256: ${_r56_sha}$" "${REPO_ROOT}/${_r56_f}" && continue
      # NÃO LAVA RESÍDUO (2026-10-06): a decisão mora na lib (onion_r56_restamp), testada por execução na
      # bancada; o hash da REGRA 56 só é recarimbado quando a revisão VIU o código que vai no commit.
      if onion_r56_restamp "${REPO_ROOT}/${_r56_f}" "${_r56_f}" "${_r56_sha}"; then
        git add "${REPO_ROOT}/${_r56_f}" && echo "🔁 hash da REGRA 56 re-carimbado em ${_r56_f} (o auto-fix mexeu só em projeções, ou a revisão é nova)"
      fi
    done
  fi
fi

# ── GATILHO DIRETO DO SUT (Q_GATILHO_DO_WIREIN, 3ª via — nem REGRA às pressas, nem esperar o
# incidente): a guarda kg-reverify-schema-check vigia commands/meta/kg-freshness.md, que NÃO mora
# em validation/ — sem esta chamada, editar o SUT sozinho passava local e o vermelho apareceria
# num commit futuro que tocasse validation/, culpando a mudança errada. Custa ~0,2s. ──
KGCHK="${REPO_ROOT}/.claude/validation/kg-reverify-schema-check.sh"
# ⚠️ sem `| grep -q`: o leitor fecha cedo, o `git` leva EPIPE e sob `pipefail` o veredito INVERTE
# com o caminho PRESENTE ([[pipefail-epipe-early-closer-class]]). Captura + here-string drena.
_kg_staged="$(onion_staged '.claude/commands/meta/kg-freshness.md' || true)"
if [ -f "${KGCHK}" ] && [ "${_kg_staged}" = ".claude/commands/meta/kg-freshness.md" ]; then
  echo "🧪 kg-freshness.md no commit → validando a estrutura do KgReverifySchema…"
  # TETO DECLARADO (4º Elenxo/A7): o check lê a ÁRVORE, não o índice — com staging parcial do
  # kg-freshness.md ele valida a versão da árvore. Aceito: o CI valida o commit real.
  _kgrc=0; bash "${KGCHK}" || _kgrc=$?
  if [ "${_kgrc}" -eq 1 ]; then
    echo "❌ Commit bloqueado: o schema embarcado em kg-freshness.md está estruturalmente quebrado."
    exit 1
  elif [ "${_kgrc}" -ge 2 ]; then
    # rc=2 é ERRO DE EXECUÇÃO do check (arquivo movido, schema não encontrado) — culpar o schema
    # apontaria o defeito errado (4º Elenxo/A7).
    echo "❌ Commit bloqueado: o kg-reverify-schema-check NÃO PÔDE rodar (rc=${_kgrc}) — leia o erro acima; o defeito é do ambiente/paths, não necessariamente do schema."
    exit 1
  fi
fi

echo "🧅 Onion pre-commit — rodando lint determinístico…"
# O RC DO LINT TEM TRES SIGNIFICADOS, e rotular os tres igual era acoplamento declarado e nao
# exercido (refutador independente, 2026-09-24): o `exit 2` nasceu nesta leva para dizer NAO PUDE
# JULGAR, e este — o unico consumidor local — imprimia "violação(ões) HARD acima" tambem nele,
# exatamente o rotulo errado que o mecanismo existe para eliminar. O idioma certo ja estava DOZE
# LINHAS acima, no check irmao do kg-reverify-schema. Agora fala a mesma lingua.
_lintrc=0
bash "${LINT}" || _lintrc=$?
if [ "${_lintrc}" -eq 1 ]; then
  echo ""
  echo "❌ Commit bloqueado: violação(ões) HARD acima. Corrija ou use 'git commit --no-verify' para pular."
  exit 1
elif [ "${_lintrc}" -ge 2 ]; then
  echo ""
  echo "❌ Commit bloqueado: o lint NÃO PÔDE JULGAR (rc=${_lintrc}) — ele morreu antes do sumário, então as"
  echo "   violações acima são PARCIAIS e o verde NÃO foi medido. Isto não é 'zero HARD': leia o bloco"
  echo "   MORREU acima e conserte a causa. Pular com --no-verify aqui é commitar sem gate nenhum."
  exit 1
fi

# Self-test das guardas — condicional. Só roda quando o COMMIT mexe no harness de
# validação (.claude/validation/**, inclui fixtures/), pois é mais lento (monta sandbox
# copiando a árvore). Assim a quebra de fixture/guarda é pega LOCAL, não só no CI — sem
# penalizar todo commit. CI roda sempre (onion-validate.yml).
#
# CUSTO MEDIDO — 2026-09-03 (faixa afetada + paralelo, D_BANCADA_FAIXAS_E_MAPA): bancada INTEIRA em
# 8 workers = **472s** (fila dinâmica; 980 casos) contra 1037s serial no mesmo dia e 1218s no CI serial;
# um commit que toca 1 helper roda só as famílias que o citam (+ as sem referência) — segundos a poucos
# minutos. Histórico: 2026-08-13: **1136s (18,9 min)**, 802 casos (Elenxo re-mediu; era 921s/612
# em 2026-08-06 — o número cresceu 23% e +190 casos SEM ninguém re-carimbar). Este comentário declarava
# "~1min" e ninguém tinha cronometrado: 15x de desvio, um caso de `behavior-over-declaration`
# no lugar mais caro, porque é por este número que se decide se vale rodar local. Se você
# mexer aqui, RE-MEDIR e trocar a linha — número de gate sem carimbo versionado é como a
# regressão cresce sem ninguém ver (é o mesmo modo de falha que apagou o histórico de
# ~16s do lint-artifacts.sh, que chegou a 86s antes dos gates de --only; re-medido 2026-08-13 pós-cura do kg-view: **78s** — o número deste comentário TAMBÉM já esteve 2x stale, cumpra a instrução acima).
# FAIXA pre-commit (D_BANCADA_FAIXAS_E_MAPA, 2026-09-03): o gatilho era "qualquer arquivo em
# .claude/validation/ ⇒ as 131 famílias, em série" (1136s medidos em 2026-08-13). Agora o gatilho
# cobre o DOMÍNIO inteiro da bancada (validation/hooks/utils, ops/, .githooks, workflows) — antes um
# commit só em hooks/ ou ops/ não rodava bancada nenhuma local — e a bancada seleciona as famílias
# AFETADAS pelos arquivos staged (mapa derivado + failsafe: infra da bancada ou arquivo desconhecido
# ⇒ tudo) e roda em paralelo (`--jobs auto`). A faixa completa continua no CI (STRICT) e no cron.
SELFTEST="${REPO_ROOT}/.claude/validation/lint-selftest.sh"
# ⚠️ DOIS MECANISMOS SABIAM COISAS DIFERENTES, E O MAIS POBRE DECIDIA. Este gatilho era SÓ a lista de
# prefixos abaixo. O `lint-selftest.sh --map` conhece uma relação MAIS RICA — ele liga
# `docs/onion/graph/fios-abertos.kg.yaml` à família `kg_backlog` —, e o gatilho ignorava isso.
# Medido em 2026-09-20: a colheita de um nó mexeu SÓ em `docs/`, o gatilho não disparou, a bancada
# NÃO RODOU no pre-commit, e o CI reprovou 30 minutos depois em dois casos de `kg_backlog` que o
# commit local declarara verdes. O custo é o de sempre: descobrir por gate vermelho é caro e é tarde.
# A cura NÃO é esticar a lista de prefixos — é PERGUNTAR AO MAPA, que é a SSOT da relação
# arquivo→família. A lista fica como failsafe: o mapa pode não existir (adotante sem a projeção) ou
# ser incompleto, e infraestrutura da bancada tem de disparar mesmo sem ele.
_bench_touched() {
  local _staged; _staged="$(git diff --cached --name-only --diff-filter=ACMR)"
  [ -n "${_staged}" ] || return 1
  # (1) failsafe por prefixo — infraestrutura da bancada dispara sempre
  grep -qE '^(\.claude/(validation|hooks|utils)/|ops/|\.githooks/|\.github/workflows/)' <<< "${_staged}" && return 0
  # (2) o MAPA: algum arquivo staged é citado por alguma família?
  [ -f "${SELFTEST}" ] || return 1
  local _map; _map="$(bash "${SELFTEST}" --map 2>/dev/null || true)"
  [ -n "${_map}" ] || return 1
  local _f
  while IFS= read -r _f; do
    [ -n "${_f}" ] || continue
    LC_ALL=C awk -F'\t' -v a="${_f}" '$2 == a { found=1 } END { exit !found }' <<< "${_map}" && return 0
  done <<< "${_staged}"
  return 1
}
if [ -f "${SELFTEST}" ] && _bench_touched; then
  echo "🧪 Onion pre-commit — mudança no domínio da bancada → self-test das guardas AFETADAS (paralelo)…"
  if ! bash "${SELFTEST}" --affected-staged --jobs auto; then
    echo ""
    echo "❌ Commit bloqueado: self-test das guardas falhou acima. Corrija ou use 'git commit --no-verify' para pular."
    exit 1
  fi
fi
