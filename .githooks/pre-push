#!/usr/bin/env bash
# pre-push do core — recusa empurrar para um PR ABERTO o commit que o CI vai reprovar.
#
# ── DEFEITO DATADO (2026-10-05) ─────────────────────────────────────────────────────────
# Num só dia, três PRs foram ao CI com lint vermelho que o gate local teria pego: #923 e #925 com o
# painel testing-state.md defasado (REGRA 81 (Painel de estado é GERADO dos produtores, nunca
# redigido)), e #924 enviado com "Violações HARD : 2" — o encadeamento lia a PRESENÇA da linha, não o
# número. Os commits tinham ido com --no-verify (checkpoint declarado), e nada entre o commit e o CI
# conferia o que ia de fato no push. O ops/pr-finalize.sh faz a sequência certa, mas é PEDIDO; este
# hook é o gatilho que não depende de alguém lembrar de pedir (gatilho social é cura nula).
#
# ── O QUE ELE JULGA ─────────────────────────────────────────────────────────────────────
#   · só branch com PR ABERTO no forge: sem PR é trabalho em curso (o checkpoint WIP para um Elenxo
#     ler é fluxo legítimo desta casa), e é o mesmo escopo da REGRA 56 (PR aberto carrega RESÍDUO da
#     passada adversarial);
#   · o COMMIT EMPURRADO, numa worktree destacada e limpa — nunca a árvore de trabalho, que pode ter
#     coisa não commitada e mentir para os dois lados;
#   · com as variáveis do CI (GITHUB_EVENT_NAME=pull_request, GITHUB_REF_NAME, GITHUB_HEAD_REF): o lint
#     roda como o runner roda, e o resíduo da REGRA 56 entra no veredito porque é HARD dentro dele;
#   · o NÚMERO de HARD lido (e o rc), nunca a presença da linha;
#   · desde 2026-10-15 (SAC-141), com o lint verde, também o PRÉ-VOO da bancada (ops/testing/preflight-run.sh,
#     o mesmo corpo do pr-finalize, com cache pela árvore): o push feito à mão pulava a bancada local inteira.
#
# ── FRONTEIRA DECLARADA ─────────────────────────────────────────────────────────────────
#   · sem `gh` INSTALADO ele não sabe se há PR: avisa e deixa passar (o CI é o gate final). Com `gh` instalado
#     mas FALHANDO (sem auth, sem rede) ele RECUSA e diz por quê — a 1ª versão lia o erro como "sem PR" e
#     deixava passar calado (bloqueador B3 do Elenxo, medido com GH_CONFIG_DIR vazio e proxy inválido);
#   · só julga push para o remote `origin` (é onde os PRs vivem); outro remote passa, com aviso;
#   · o commit que o ops/pr-finalize.sh acabou de julgar (marcador no git-common-dir) não é relintado:
#     a 1ª versão lintava o mesmo commit duas vezes, ~11 min por fechamento (maior M6);
#   · `git push --no-verify` pula este hook, como pula o pre-commit; é escape de humano, declarado;
#   · custa um lint por branch com PR aberto, por push: MEDIDO ~216 s sob carga (load 5-7 em 8 cores) —
#     a 1ª redação dizia 15-30 s, número de lint ocioso.
#
# Pontos de teste (só a bancada usa, e SÓ com ONION_PREPUSH_TEST=1 — sem isso, um `ONION_PREPUSH_PR=` vazio
# esquecido no shell desligava o hook calado): ONION_PREPUSH_PR (nº do PR, pula o gh), ONION_PREPUSH_LINT
# (lint no lugar do real), ONION_PREPUSH_NO_WORKTREE=1 (julga o diretório atual).
# >>> onion-hook-trampoline >>>
# TRAMPOLIM DE WORKTREE: com core.hooksPath ABSOLUTO (o Claude Code o grava ao criar worktree de
# agente), toda worktree rodaria o hook do checkout PRINCIPAL e um PR que muda este hook não seria
# provado por ele mesmo. Só age quando ESTE hook mora no `.githooks/` do checkout principal deste
# repo (identidade de diretório; hook em `.git/hooks`, husky ou diretório central não trampolina).
# Aí, se a árvore atual tem o MESMO hook, executável e de conteúdo diferente, ele assume com os
# mesmos argumentos e stdin. Árvore sem o hook: segue este (o gate nunca deixa de rodar). Hook da
# árvore presente e NÃO executável: FALHA FECHADO (revisão do adotante sge, 2026-10-26). Antes caía em
# silêncio no do principal: o hook sob teste não rodava, e o bit perdido chegava à main, onde o git
# IGNORA hook não executável e o gate inteiro some. Rodá-lo por `bash` esconderia o mesmo bit perdido.
# A variável guarda o alvo contra laço e é limpa logo abaixo, para não vazar a um git aninhado.
_onion_top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
_onion_cmn="$(CDPATH= cd "$(git rev-parse --git-common-dir 2>/dev/null || echo /nonexistent)" 2>/dev/null && cd .. && pwd || true)"
_onion_tt="${_onion_top}/.githooks/${0##*/}"
if [ -n "${_onion_top}" ] && [ -n "${_onion_cmn}" ] && [ "${0%/*}" -ef "${_onion_cmn}/.githooks" ] \
   && [ "${ONION_HOOK_TRAMPOLINED:-}" != "${_onion_tt}" ] && [ -f "${_onion_tt}" ] && ! [ "${_onion_tt}" -ef "$0" ]; then
  if ! [ -x "${_onion_tt}" ]; then
    echo "❌ ${0##*/} bloqueado: ${_onion_tt} existe e NÃO é executável — o git o ignoraria e o gate desta árvore não roda. Corrija: chmod +x '${_onion_tt}' (e commite o modo 100755)." >&2
    exit 1
  fi
  if ! cmp -s "${_onion_tt}" "$0"; then
    export ONION_HOOK_TRAMPOLINED="${_onion_tt}"
    exec "${_onion_tt}" "$@"
  fi
fi
unset _onion_top _onion_cmn _onion_tt ONION_HOOK_TRAMPOLINED
# <<< onion-hook-trampoline <<<
set -uo pipefail

ZERO=0000000000000000000000000000000000000000
ROOT="$(git rev-parse --show-toplevel)" || exit 0
fail=0
REMOTE="${1:-origin}"; URL="${2:-}"
if [ "${ONION_PREPUSH_TEST:-0}" != 1 ]; then unset ONION_PREPUSH_PR ONION_PREPUSH_LINT ONION_PREPUSH_NO_WORKTREE ONION_PREPUSH_PREFLIGHT; fi
# julga pelo DESTINO, não pelo nome (menor 7 do Elenxo 2): `git push <url-do-origin>` ou um remote
# `mirror` com a mesma URL entregavam HARD no PR sem julgamento
ORIGIN_URL="$(git remote get-url --push origin 2>/dev/null || true)"
if [ "${REMOTE}" != origin ] && { [ -z "${ORIGIN_URL}" ] || [ "${URL}" != "${ORIGIN_URL}" ]; }; then
  echo "pre-push: destino '${REMOTE}' não é o origin — PRs vivem no origin; NÃO julguei." >&2
  exit 0
fi
MARK="$(git rev-parse --git-common-dir 2>/dev/null)/onion-prefinalize-ok"

while read -r _lref lsha rref _rsha; do
  [ -n "${lsha:-}" ] || continue
  [ "${lsha}" = "${ZERO}" ] && continue                     # deleção de ref: nada a julgar
  case "${rref}" in refs/heads/*) ;; *) continue ;; esac     # tags e afins: fora de escopo
  br="${rref#refs/heads/}"

  # o commit que o pr-finalize ACABOU de julgar não depende do gh (maior 5 do Elenxo 2: com o gh
  # falhando, o caminho canônico `pr-finalize --push` terminava pedindo --no-verify)
  if [ -f "${MARK}" ] && [ "$(cat "${MARK}" 2>/dev/null)" = "${lsha}" ]; then
    echo "pre-push: '${br}' @ ${lsha:0:12} — este commit acabou de passar no pr-finalize (lint 0 HARD); não relinto." >&2
    continue
  fi
  num="${ONION_PREPUSH_PR-}"
  if [ -z "${ONION_PREPUSH_PR+x}" ]; then
    if ! command -v gh >/dev/null 2>&1; then
      echo "pre-push: sem 'gh' não sei se '${br}' tem PR aberto — NÃO julguei; o CI julga." >&2
      continue
    fi
    gerr="$(mktemp)"
    num="$(gh pr list --head "${br}" --state open --json number --jq '.[0].number' 2>"${gerr}" </dev/null)"; grc=$?
    if [ "${grc}" != 0 ]; then
      echo "pre-push: RECUSADO '${br}' — o gh falhou (rc=${grc}: $(head -c 160 "${gerr}")); sem ele não sei se há PR aberto. Autentique o gh ou, se for deliberado, 'git push --no-verify'." >&2
      rm -f "${gerr}"; fail=1; continue
    fi
    rm -f "${gerr}"
  fi
  [ -n "${num}" ] || continue                                # sem PR aberto: trabalho em curso

  lint="${ONION_PREPUSH_LINT:-.claude/validation/lint-artifacts.sh}"
  if [ "${ONION_PREPUSH_NO_WORKTREE:-0}" = 1 ]; then
    wt="${ROOT}"; tmp=""
  else
    tmp="$(mktemp -d)"; wt="${tmp}/wt"
    if ! git -C "${ROOT}" worktree add -q --detach "${wt}" "${lsha}" 2>/dev/null </dev/null; then
      echo "pre-push: não consegui montar ${lsha:0:12} para julgar — RECUSO (não sei o que vai)." >&2
      rm -rf "${tmp}"; fail=1; continue
    fi
  fi
  out="$(cd "${wt}" && GITHUB_EVENT_NAME=pull_request GITHUB_REF_NAME="${num}/merge" GITHUB_HEAD_REF="${br}" \
         LC_ALL=C bash "${lint}" 2>&1 </dev/null)"; rc=$?
  hard="$(printf '%s\n' "${out}" | grep -oE 'Violações HARD : [0-9]+' | grep -oE '[0-9]+$' | tail -1)"
  # o PRÉ-VOO da bancada sobre o MESMO commit (SAC-141, 2026-10-15): o push que não passou pelo pr-finalize
  # pulava a bancada local inteira. Só depois do lint verde, e só onde o corpo existe (core).
  pfo="" pfrc=0
  # ONION_PREPUSH_PREFLIGHT (ponto de teste, 2026-10-18): a bancada aponta um stub. Sem ele, os casos da família
  # pre_push rodavam o pré-voo do CHECKOUT VIVO; num PR que mexe na própria família, ela rodava dentro de si
  # mesma e o veredito dependia do cache do pré-voo (medido: 1 ✗ sem cache, 58/58 com).
  pfs="${ONION_PREPUSH_PREFLIGHT:-ops/testing/preflight-run.sh}"
  if [ "${rc}" = 0 ] && [ "${hard}" = 0 ] && { [ -n "${ONION_PREPUSH_PREFLIGHT:-}" ] || [ -f "${wt}/ops/testing/preflight-run.sh" ]; }; then
    pfo="$(cd "${wt}" && bash "${pfs}" 2>&1 </dev/null)" || pfrc=$?
  fi
  if [ -n "${tmp}" ]; then git -C "${ROOT}" worktree remove --force "${wt}" >/dev/null 2>&1; rm -rf "${tmp}"; fi

  if [ "${rc}" = 0 ] && [ "${hard}" = 0 ] && [ "${pfrc}" = 0 ]; then
    echo "pre-push: '${br}' (PR #${num}) @ ${lsha:0:12} — lint 0 HARD, como o CI vai ver.${pfo:+ $(tail -n 1 <<< "${pfo}")}" >&2
    continue
  fi
  if [ "${pfrc}" != 0 ]; then
    echo "pre-push: RECUSADO '${br}' (PR #${num}) @ ${lsha:0:12} — o pré-voo da bancada reprovou (rc=${pfrc}):" >&2
    printf '%s\n' "${pfo}" | tail -n 14 >&2
    echo "pre-push: feche o PR com 'bash ops/pr-finalize.sh --push' (projeções, resíduo, pré-voo e lint na ordem certa)." >&2
    fail=1; continue
  fi
  echo "pre-push: RECUSADO '${br}' (PR #${num}) @ ${lsha:0:12} — lint rc=${rc}, HARD=${hard:-?}." >&2
  # sem filtro por palavra: o filtro anterior escondia o HARD real atrás de 5 SOFT (maior M4 do Elenxo)
  printf '%s\n' "${out}" | grep -E '^VIOLATION' | head -40 >&2
  echo "pre-push: feche o PR com 'bash ops/pr-finalize.sh --push' (projeções, resíduo e lint na ordem certa)." >&2
  fail=1
done

exit "${fail}"
